{%- if settings.enable_preloading_screen -%}
  <style>
    .preloader {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100vw;
      height: 100vh;
      z-index: 999999;
      background: {{ settings.preloading_screen_bg | default: '#4e0a3a' }};
      color: {{ settings.preloading_screen_text_color | default: '#EAACC9' }};
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      transition: opacity 0.8s ease, visibility 0.8s ease;
      pointer-events: all;
    }
    .preloader.done {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .preloader-mark {
      width: 64px;
      height: 64px;
      animation: floatMark 2.4s ease-in-out infinite;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .preloader-mark svg {
      width: 100%;
      height: 100%;
    }
    .preloader-mark img,
    .preloader-logo-img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      width: auto;
      height: auto;
    }
    @keyframes floatMark {
      0%, 100% { transform: translateY(0) rotate(0); }
      50% { transform: translateY(-10px) rotate(8deg); }
    }
    .preloader-word {
      font-family: var(--serif, 'Instrument Serif', Georgia, serif);
      font-style: italic;
      font-size: 1.6rem;
      letter-spacing: 0.05em;
      color: {{ settings.preloading_screen_text_color | default: '#EAACC9' }};
      text-transform: uppercase;
    }
    .preloader-bar {
      width: 160px;
      height: 2px;
      background: rgba(241, 237, 236, 0.2);
      overflow: hidden;
      border-radius: 2px;
    }
    .preloader-bar span {
      display: block;
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, {{ settings.preloading_screen_text_color | default: '#EAACC9' }}, var(--olive, #9F9F46));
      transition: width 0.2s ease;
    }
  </style>

  <div class="preloader no-js-hidden" id="preloader">
    <div class="preloader-mark">
      {%- if settings.preloading_screen_image != blank -%}
        {%- assign logo_alt = settings.preloading_screen_image.alt | default: shop.name | escape -%}
        <img
          src="{{ settings.preloading_screen_image | image_url: width: 300 }}"
          alt="{{ logo_alt }}"
          width="{{ settings.preloading_screen_image.width }}"
          height="{{ settings.preloading_screen_image.height }}"
          loading="eager"
          class="preloader-logo-img"
        >
      {%- else -%}
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill="{{ settings.preloading_screen_text_color | default: '#EAACC9' }}" d="M50 8 C 56 20, 64 24, 74 22 C 72 32, 76 40, 88 50 C 76 60, 72 68, 74 78 C 64 76, 56 80, 50 92 C 44 80, 36 76, 26 78 C 28 68, 24 60, 12 50 C 24 40, 28 32, 26 22 C 36 24, 44 20, 50 8 Z"/>
        </svg>
      {%- endif -%}
    </div>
    <div class="preloader-word">
      {%- if settings.preloading_screen_text != blank -%}
        {{ settings.preloading_screen_text }}
      {%- else -%}
        AMYZA
      {%- endif -%}
    </div>
    <div class="preloader-bar"><span></span></div>
  </div>

  <script>
    (function initPreloader() {
      var pre = document.getElementById('preloader');
      if (!pre) { document.body.classList.add('loaded'); return; }
      var bar = pre.querySelector('.preloader-bar span');
      var p = 0;
      var tick = setInterval(function () {
        p += Math.random() * 14 + 4;
        if (p > 96) p = 96;
        if (bar) bar.style.width = p + '%';
      }, 120);
      function done() {
        clearInterval(tick);
        if (bar) bar.style.width = '100%';
        setTimeout(function () {
          pre.classList.add('done');
          document.body.classList.add('loaded');
        }, 260);
      }
      var fired = false;
      function fire() { if (!fired) { fired = true; done(); } }
      if (document.readyState === 'complete') {
        setTimeout(fire, 400);
      } else {
        window.addEventListener('load', function () { setTimeout(fire, 400); });
      }
      setTimeout(fire, 2600);
    })();
  </script>
{%- endif -%}