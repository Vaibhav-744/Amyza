<div class="product-item{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"{% if settings.banner_animation == 'effect_fade_up' %} data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}>
    <div class="card">
        <div class="card-product">
            <div class="card-product__wrapper">
                {%- liquid
                    assign featured_media_aspect_ratio = product_card_product.featured_media.aspect_ratio
                    if product_card_product.featured_media.aspect_ratio == nil
                        assign featured_media_aspect_ratio = 1
                    endif
                -%}
                <div class="card-media animated-loading"{% if product_card_product.featured_media %}{% if media_size == 'adapt' %} style="padding-bottom: {{ 1 | divided_by: featured_media_aspect_ratio | times: 100 }}%;"{% elsif media_size == 'square' %} style="padding-bottom: 100%;"{% elsif media_size == 'portrait' %}{% if portrait_aspect_ratio != blank %} style="padding-bottom: {{ portrait_aspect_ratio | append: '%' }};"{% endif %}{% endif %}
                    {%- else -%} style="padding-bottom: 100%;"{%- endif -%}>
                    {%- if product_card_product.featured_media != blank -%}
                        <img src="{{ product_card_product.featured_media | image_url: width: 600 }}" alt="{{ product_card_product.title | escape }}" loading="lazy" width="600" height="{{ 600 | divided_by: featured_media_aspect_ratio | round }}">
                    {%- endif -%}
                    <a class="card-link" href="{{ product_card_product.url | within: collection }}" title="{{ product_card_product.title | escape }}"></a>
                </div>
            </div>
        </div>

        <div class="product-info text-{{ settings.product_content_text_align | default: 'left' }}">
            {%- assign product_type_label = product_card_product.metafields.custom.product_type | default: product_card_product.type -%}
            {%- if product_type_label == blank -%}
                {%- assign product_type_label = '✦ ' | append: product_card_product.vendor | default: '✦ The Ritual' -%}
            {%- endif -%}
            <div class="product-category">{{ product_type_label }}</div>

            <h3 class="product-title">
                <a class="card-title link-underline{% if settings.product_title_line_text != 'full' %} card-title-ellipsis{% endif %}" href="{{ product_card_product.url | within: collection }}">{{ product_card_product.title | escape }}</a>
            </h3>

            <div class="product-desc">
                {%- if product_card_product.metafields.custom.product_info != blank -%}
                    {{ product_card_product.metafields.custom.product_info | metafield_tag }}
                {%- elsif product_card_product.description != blank -%}
                    {{ product_card_product.description | strip_html | truncate: 65 }}
                {%- endif -%}
            </div>

            <div class="product-footer">
                <div class="product-price-wrapper">
                    <span class="product-price">
                        {{ product_card_product.price | money_without_trailing_zeros }}
                    </span>
                    {%- if product_card_product.variants.first.title != 'Default Title' and product_card_product.variants.first.title != blank -%}
                        <span class="price-note">
                            / {{ product_card_product.variants.first.title }}
                        </span>
                    {%- endif -%}
                </div>
                <div class="card-action card-action-footer">
                    {% render 'add-to-cart-form', product: product_card_product, id: 'form', position: 0, sectionId: sectionId %}
                </div>
            </div>
        </div>
    </div>
</div>