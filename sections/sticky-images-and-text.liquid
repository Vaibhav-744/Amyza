{% comment %} sticky-images-and-text.liquid — Scroll-driven horizontal image & synced text section {% endcomment %}

{%- liquid
  assign slide_count = section.blocks.size
  assign overlay_alpha = section.settings.image_overlay_opacity | default: 25 | divided_by: 100.0
-%}

<style>
  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} sticky-images-and-text {
    display: block;
    position: relative;
    background-color: {{ section.settings.section_bg }};
    color: {{ section.settings.heading_color }};
    --sit-count: {{ slide_count | at_least: 1 }};
  }

  /* ── Desktop Vertical Scroll Track driving Horizontal Motion ── */
  #shopify-section-{{ section.id }} .sit-track {
    position: relative;
    width: 100%;
    height: calc(var(--sit-count) * {{ section.settings.scroll_height_per_slide | default: 100 }}vh);
  }

  #shopify-section-{{ section.id }} .sit-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding-top: var(--header-h, 70px);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .sit-container {
    position: relative;
    width: 100%;
    max-width: 1400px;
    height: 100%;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4.5vw, 4rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .sit-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 5.5rem);
    align-items: center;
    width: 100%;
  }

  /* ── Left: Horizontal-Gliding Rounded Image Viewport ── */
  #shopify-section-{{ section.id }} .sit-media-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius | default: 24 }}px;
    background: rgba(0, 0, 0, 0.18);
  }

  #shopify-section-{{ section.id }} .sit-media-strip {
    display: flex;
    width: 100%;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  #shopify-section-{{ section.id }} .sit-media-slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio | default: '16 / 10' }};
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sit-media-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  #shopify-section-{{ section.id }} .sit-media-scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ overlay_alpha }});
    pointer-events: none;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .sit-media-overlay-title {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sit-media-overlay-title span {
    {%- if section.settings.overlay_title_font == 'serif' -%}
      font-family: var(--serif, 'Instrument Serif', Georgia, serif);
      font-weight: 400;
    {%- else -%}
      font-family: var(--sans, 'Public Sans', system-ui, sans-serif);
      font-weight: 700;
    {%- endif -%}
    font-size: clamp(2.2rem, 4.4vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: {{ section.settings.overlay_title_color }};
    text-shadow: 0 4px 28px rgba(0, 0, 0, 0.3);
  }

  /* ── Right: Synced Text Stack ── */
  #shopify-section-{{ section.id }} .sit-text-col {
    position: relative;
    width: 100%;
    display: grid;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .sit-text-slide {
    grid-area: 1 / 1;
    width: 100%;
    text-align: {{ section.settings.text_align | default: 'right' }};
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1), transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  #shopify-section-{{ section.id }} .sit-text-slide.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .sit-eyebrow {
    display: block;
    font-family: var(--sans, 'Public Sans', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow, 0.2em);
    color: {{ section.settings.eyebrow_color }};
    margin-bottom: 0.75rem;
  }

  #shopify-section-{{ section.id }} .sit-heading {
    {%- if section.settings.heading_font == 'serif' -%}
      font-family: var(--serif, 'Instrument Serif', Georgia, serif);
      font-weight: 400;
      font-size: clamp(2rem, 3.6vw, 3.2rem);
    {%- else -%}
      font-family: var(--sans, 'Public Sans', system-ui, sans-serif);
      font-weight: 600;
      font-size: clamp(1.6rem, 2.7vw, 2.4rem);
    {%- endif -%}
    line-height: 1.18;
    letter-spacing: var(--ls-title, -0.015em);
    color: {{ section.settings.heading_color }};
    margin: 0 0 1rem;
  }

  #shopify-section-{{ section.id }} .sit-desc {
    font-family: var(--sans, 'Public Sans', system-ui, sans-serif);
    font-size: clamp(0.95rem, 1.25vw, 1.1rem);
    line-height: 1.65;
    letter-spacing: var(--ls-body, 0);
    color: {{ section.settings.body_color }};
    max-width: 44ch;
    {%- if section.settings.text_align == 'right' -%}
      margin-left: auto;
      margin-right: 0;
    {%- elsif section.settings.text_align == 'center' -%}
      margin-left: auto;
      margin-right: auto;
    {%- else -%}
      margin-left: 0;
      margin-right: auto;
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .sit-desc p {
    margin: 0;
  }

  /* ── Bottom-Right Indicator Dots / Active Pill ── */
  #shopify-section-{{ section.id }} .sit-dots {
    position: absolute;
    bottom: clamp(1.8rem, 5vh, 3.5rem);
    right: clamp(1.5rem, 4.5vw, 4rem);
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 5;
  }

  #shopify-section-{{ section.id }} .sit-dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: 1.5px solid {{ section.settings.dot_color }};
    background: transparent;
    padding: 0;
    cursor: pointer;
    opacity: 0.45;
    transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease, border-color 0.3s ease;
  }

  #shopify-section-{{ section.id }} .sit-dot:hover {
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .sit-dot.is-active {
    width: 34px;
    opacity: 1;
    border-color: {{ section.settings.dot_active_color }};
  }

  /* ── Mobile Horizontal Swipe Layout (≤860px) ── */
  #shopify-section-{{ section.id }} .sit-mobile {
    display: none;
  }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .sit-track {
      display: none;
    }

    #shopify-section-{{ section.id }} .sit-mobile {
      display: block;
      padding: 3.5rem 0 3rem;
    }

    #shopify-section-{{ section.id }} .sit-mobile-scroller {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 1rem;
      padding: 0 1.25rem;
    }

    #shopify-section-{{ section.id }} .sit-mobile-scroller::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .sit-mobile-card {
      flex: 0 0 100%;
      width: 100%;
      scroll-snap-align: center;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    #shopify-section-{{ section.id }} .sit-mobile-media {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 10;
      border-radius: {{ section.settings.image_radius | default: 24 | at_most: 20 }}px;
      overflow: hidden;
      background: rgba(0, 0, 0, 0.18);
    }

    #shopify-section-{{ section.id }} .sit-mobile-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #shopify-section-{{ section.id }} .sit-mobile-text {
      text-align: left;
      padding: 0 0.25rem;
    }

    #shopify-section-{{ section.id }} .sit-mobile-text .sit-desc {
      margin-left: 0;
      margin-right: auto;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .sit-mobile-dots {
      position: static;
      justify-content: center;
      margin-top: 1.75rem;
    }
  }
</style>

{%- if slide_count > 0 -%}
  <sticky-images-and-text
    class="sticky-images-and-text"
    id="sticky-images-and-text-{{ section.id }}"
    data-section-id="{{ section.id }}"
    data-slide-count="{{ slide_count }}"
  >
    {%- comment -%} Desktop Scroll-Pinned Horizontal Experience {%- endcomment -%}
    <div class="sit-track" data-sit-track>
      <div class="sit-sticky">
        <div class="sit-container">
          <div class="sit-grid">

            <div class="sit-media-viewport">
              <div class="sit-media-strip" data-sit-media-strip>
                {%- for block in section.blocks -%}
                  <div
                    class="sit-media-slide{% if forloop.first %} is-active{% endif %}"
                    data-sit-media-slide="{{ forloop.index0 }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.image != blank -%}
                      <img
                        src="{{ block.settings.image | image_url: width: 1200 }}"
                        srcset="
                          {{ block.settings.image | image_url: width: 600 }} 600w,
                          {{ block.settings.image | image_url: width: 900 }} 900w,
                          {{ block.settings.image | image_url: width: 1200 }} 1200w
                        "
                        sizes="(max-width: 860px) 100vw, 50vw"
                        alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                        width="{{ block.settings.image.width | default: 1200 }}"
                        height="{{ block.settings.image.height | default: 750 }}"
                        loading="lazy"
                      >
                    {%- else -%}
                      <img
                        src="https://placehold.co/1200x750/7D0A50/F2EDEC?text=Slide+{{ forloop.index }}"
                        alt="{{ block.settings.heading | default: 'Feature' | escape }}"
                        width="1200"
                        height="750"
                      >
                    {%- endif -%}

                    <div class="sit-media-scrim"></div>

                    {%- if block.settings.image_title != blank -%}
                      <div class="sit-media-overlay-title">
                        <span>{{ block.settings.image_title }}</span>
                      </div>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>

            <div class="sit-text-col">
              {%- for block in section.blocks -%}
                <div
                  class="sit-text-slide{% if forloop.first %} is-active{% endif %}"
                  data-sit-text-slide="{{ forloop.index0 }}"
                >
                  {%- if block.settings.eyebrow != blank -%}
                    <span class="sit-eyebrow">{{ block.settings.eyebrow }}</span>
                  {%- endif -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="sit-heading">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <div class="sit-desc">{{ block.settings.description }}</div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>

          </div>

          {%- if slide_count > 1 -%}
            <div class="sit-dots" role="tablist" aria-label="Feature slides">
              {%- for block in section.blocks -%}
                <button
                  type="button"
                  class="sit-dot{% if forloop.first %} is-active{% endif %}"
                  data-sit-dot="{{ forloop.index0 }}"
                  aria-label="Go to slide {{ forloop.index }}: {{ block.settings.image_title | default: block.settings.heading | escape }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} Mobile Horizontal Swipe Experience {%- endcomment -%}
    <div class="sit-mobile">
      <div class="sit-mobile-scroller" data-sit-mobile-scroller>
        {%- for block in section.blocks -%}
          <div class="sit-mobile-card" data-sit-mobile-slide="{{ forloop.index0 }}">
            <div class="sit-mobile-media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                  width="900"
                  height="562"
                  loading="lazy"
                >
              {%- else -%}
                <img
                  src="https://placehold.co/900x562/7D0A50/F2EDEC?text=Slide+{{ forloop.index }}"
                  alt="{{ block.settings.heading | default: 'Feature' | escape }}"
                  width="900"
                  height="562"
                >
              {%- endif -%}
              <div class="sit-media-scrim"></div>
              {%- if block.settings.image_title != blank -%}
                <div class="sit-media-overlay-title">
                  <span>{{ block.settings.image_title }}</span>
                </div>
              {%- endif -%}
            </div>

            <div class="sit-mobile-text">
              {%- if block.settings.eyebrow != blank -%}
                <span class="sit-eyebrow">{{ block.settings.eyebrow }}</span>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="sit-heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="sit-desc">{{ block.settings.description }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if slide_count > 1 -%}
        <div class="sit-dots sit-mobile-dots" role="tablist" aria-label="Feature slides mobile">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="sit-dot{% if forloop.first %} is-active{% endif %}"
              data-sit-mobile-dot="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </sticky-images-and-text>
{%- endif -%}

<script>
  (function () {
    if (customElements.get('sticky-images-and-text')) return;

    class StickyImagesAndText extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-sit-track]');
        this.strip = this.querySelector('[data-sit-media-strip]');
        this.textSlides = Array.from(this.querySelectorAll('[data-sit-text-slide]'));
        this.dots = Array.from(this.querySelectorAll('[data-sit-dot]'));
        this.mobileScroller = this.querySelector('[data-sit-mobile-scroller]');
        this.mobileSlides = Array.from(this.querySelectorAll('[data-sit-mobile-slide]'));
        this.mobileDots = Array.from(this.querySelectorAll('[data-sit-mobile-dot]'));
        this.count = this.textSlides.length;
        this.activeIndex = 0;
        this.ticking = false;

        if (this.count <= 1) return;

        this.onScroll = this.onScroll.bind(this);
        this.updateDesktop = this.updateDesktop.bind(this);
        this.onBlockSelect = (e) => {
          if (!this.contains(e.target)) return;
          const idx = parseInt(e.target.getAttribute('data-sit-media-slide'), 10);
          if (!isNaN(idx)) {
            this.scrollToDesktopSlide(idx);
          }
        };

        window.addEventListener('scroll', this.onScroll, { passive: true });
        window.addEventListener('resize', this.onScroll, { passive: true });
        document.addEventListener('shopify:block:select', this.onBlockSelect);

        this.dots.forEach((dot, idx) => {
          dot.addEventListener('click', () => this.scrollToDesktopSlide(idx));
        });

        if (this.mobileScroller) {
          this.mobileScroller.addEventListener('scroll', () => {
            const width = this.mobileScroller.clientWidth || 1;
            const idx = Math.max(0, Math.min(this.count - 1, Math.round(this.mobileScroller.scrollLeft / width)));
            this.setMobileActive(idx);
          }, { passive: true });

          this.mobileDots.forEach((dot, idx) => {
            dot.addEventListener('click', () => {
              const target = this.mobileSlides[idx];
              if (target) {
                this.mobileScroller.scrollTo({ left: target.offsetLeft - 20, behavior: 'smooth' });
              }
            });
          });
        }

        this.updateDesktop();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.onScroll);
        window.removeEventListener('resize', this.onScroll);
        if (this.onBlockSelect) {
          document.removeEventListener('shopify:block:select', this.onBlockSelect);
        }
      }

      onScroll() {
        if (this.ticking) return;
        this.ticking = true;
        requestAnimationFrame(() => {
          this.updateDesktop();
          this.ticking = false;
        });
      }

      updateDesktop() {
        if (!this.track || !this.strip || window.innerWidth <= 860) return;

        const rect = this.track.getBoundingClientRect();
        const scrollable = Math.max(1, this.track.offsetHeight - window.innerHeight);
        const scrolled = Math.max(0, Math.min(scrollable, -rect.top));
        const rawProgress = scrolled / scrollable;
        const slidePos = rawProgress * (this.count - 1);

        this.strip.style.transform = 'translate3d(' + (-slidePos * 100) + '%, 0, 0)';

        const idx = Math.max(0, Math.min(this.count - 1, Math.round(slidePos)));
        if (idx !== this.activeIndex) {
          this.activeIndex = idx;
          this.textSlides.forEach((el, i) => el.classList.toggle('is-active', i === idx));
          this.dots.forEach((el, i) => {
            el.classList.toggle('is-active', i === idx);
            el.setAttribute('aria-selected', i === idx ? 'true' : 'false');
          });
        }
      }

      scrollToDesktopSlide(idx) {
        if (!this.track) return;
        const trackTop = this.track.getBoundingClientRect().top + window.scrollY;
        const scrollable = Math.max(1, this.track.offsetHeight - window.innerHeight);
        const targetY = trackTop + (idx / Math.max(1, this.count - 1)) * scrollable;
        window.scrollTo({ top: targetY, behavior: 'smooth' });
      }

      setMobileActive(idx) {
        this.mobileDots.forEach((el, i) => {
          el.classList.toggle('is-active', i === idx);
          el.setAttribute('aria-selected', i === idx ? 'true' : 'false');
        });
      }
    }

    customElements.define('sticky-images-and-text', StickyImagesAndText);
  })();
</script>

{% schema %}
{
  "name": "Sticky Images & Text",
  "tag": "section",
  "class": "section-sticky-images-and-text",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#4E0A3A"
    },
    {
      "type": "range",
      "id": "scroll_height_per_slide",
      "label": "Scroll Distance per Slide (vh)",
      "min": 70,
      "max": 140,
      "step": 10,
      "unit": "vh",
      "default": 100,
      "info": "Controls how much vertical scroll transitions each horizontal slide on desktop."
    },
    {
      "type": "header",
      "content": "Image Card"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "default": "16 / 10",
      "options": [
        { "value": "16 / 10", "label": "Landscape (16:10)" },
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "4 / 3", "label": "Classic (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image Corner Radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "label": "Image Dark Overlay Opacity (%)",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "select",
      "id": "overlay_title_font",
      "label": "Image Overlay Title Font",
      "default": "sans",
      "options": [
        { "value": "sans", "label": "Sans-serif Bold" },
        { "value": "serif", "label": "Instrument Serif" }
      ]
    },
    {
      "type": "color",
      "id": "overlay_title_color",
      "label": "Image Overlay Title Color",
      "default": "#F7F4E3"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment (Desktop)",
      "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "sans",
      "options": [
        { "value": "sans", "label": "Sans-serif" },
        { "value": "serif", "label": "Instrument Serif" }
      ]
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#F0AEBC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#F2EDEC"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Description Color",
      "default": "#EEDCE6"
    },
    {
      "type": "header",
      "content": "Pagination Indicators"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Inactive Dot Border Color",
      "default": "#F2EDEC"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active Pill Border Color",
      "default": "#F2EDEC"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_title",
          "label": "Image Center Overlay Title",
          "default": "Protect."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow (Optional)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Radiance, Built Into Your Ritual."
        },
        {
          "type": "richtext",
