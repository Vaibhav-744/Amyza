{% comment %} bot-promise.liquid — Sourcing promise steps {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .bot-promise {
    padding: clamp(3rem, 7vw, 6rem) 6vw;
    background: {{ section.settings.section_bg }};
  }

  /* ── Header ── */
  #shopify-section-{{ section.id }} .bot-promise .section-header .eyebrow {
    color: {{ section.settings.eyebrow_color }};
  }
  #shopify-section-{{ section.id }} .bot-promise .section-header h2 {
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .bot-promise .section-header h2 em {
    color: {{ section.settings.heading_italic_color }};
  }

  /* ── Steps grid ── */
  #shopify-section-{{ section.id }} .bot-steps {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, 1fr);
    gap: 2rem;
    margin-top: 2.4rem;
    max-width: 1300px;
    margin-left: auto;
    margin-right: auto;
  }
  #shopify-section-{{ section.id }} .bot-step {
    border-top: 1px solid {{ section.settings.step_border_color }};
    padding-top: 1.4rem;
  }
  #shopify-section-{{ section.id }} .bot-step-no {
    font-family: var(--serif);
    font-size: 2.4rem;
    color: {{ section.settings.step_num_color }};
    display: block;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .bot-step h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.4rem;
    color: {{ section.settings.step_title_color }};
    margin: .6rem 0 .5rem;
  }
  #shopify-section-{{ section.id }} .bot-step p {
    color: {{ section.settings.step_body_color }};
    font-size: .95rem;
    line-height: 1.6;
    opacity: .82;
  }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .bot-steps {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
    #shopify-section-{{ section.id }} .bot-promise {
      padding: 2.6rem 1.2rem;
    }
  }
</style>

<section class="bot-promise" id="bot-promise-{{ section.id }}">

  <div class="section-header light reveal-up" data-stagger>
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow" data-rise>{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 data-split>{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="bot-steps" data-stagger>
    {%- for block in section.blocks -%}
      <div class="bot-step" data-rise {{ block.shopify_attributes }}>
        {%- if block.settings.number != blank -%}
          <span class="bot-step-no">{{ block.settings.number }}</span>
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <h3>{{ block.settings.title }}</h3>
        {%- endif -%}
        {%- if block.settings.body != blank -%}
          <p>{{ block.settings.body }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

</section>

{% schema %}
{
  "name": "Bot — Promise",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "default": "#731157",
      "info": "Default: --plum (#731157)"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "✦ The Sourcing Promise"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#EAACC9"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From soil to skin."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#F1EDEC"
    },
    {
      "type": "color",
      "id": "heading_italic_color",
      "label": "Heading Italic Color",
      "default": "#EAACC9"
    },
    {
      "type": "header",
      "content": "Steps"
    },
    {
      "type": "color",
      "id": "step_border_color",
      "label": "Step Border",
      "default": "rgba(241,237,236,0.25)"
    },
    {
      "type": "color",
      "id": "step_num_color",
      "label": "Step Number Color",
      "default": "#EAACC9"
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step Title Color",
      "default": "#F1EDEC"
    },
    {
      "type": "color",
      "id": "step_body_color",
      "label": "Step Body Color",
      "default": "#F1EDEC"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Chosen by hand"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "We work with small growers who farm the way their families always have — slowly, seasonally, without shortcuts."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bot — Promise",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "01",
            "title": "Chosen by hand",
            "body": "We work with small growers who farm the way their families always have — slowly, seasonally, without shortcuts."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Proven, then trusted",
            "body": "Every botanical is tested for potency and purity. Heritage gets the first word; the lab gets the last."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "Whole, never wasted",
            "body": "Cruelty-free, paraben-free, and formulated in small batches so nothing sits, and nothing is lost."
          }
        }
      ]
    }
  ]
}
{% endschema %}
