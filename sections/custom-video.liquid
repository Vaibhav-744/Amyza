{% comment %}
  Custom Hero Video Section
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .hero-video{
    position:relative;
    overflow:hidden;
    color:{{ section.settings.text_color }};
    height:calc(100vh - 143px);
    min-height:calc(100vh - 143px);
    display:flex;
    align-items:flex-end;
    background:{{ section.settings.fallback_bg }};
  }

  body[allow-transparency] #shopify-section-{{ section.id }} .hero-video{
    height:100vh;
    min-height:100vh;
  }

  #shopify-section-{{ section.id }} .hero-video-bg,
  #shopify-section-{{ section.id }} .hero-image-bg {
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:{{ section.settings.image_position | default: 'center center' }};
    z-index:0;
    display:block;
  }

  #shopify-section-{{ section.id }} .hero-image-wrap {
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    z-index:0;
    display:block;
  }

  #shopify-section-{{ section.id }} .hero-video-overlay{
    position:absolute;
    inset:0;
    z-index:1;
    background:
      linear-gradient(
        180deg,
        {{ section.settings.overlay_top }} 0%,
        {{ section.settings.overlay_middle }} 50%,
        {{ section.settings.overlay_bottom }} 100%
      ),
      radial-gradient(
        ellipse at 30% 70%,
        {{ section.settings.overlay_glow }},
        transparent 60%
      );
  }

  #shopify-section-{{ section.id }} .hero-video-content{
    position:relative;
    z-index:2;
    max-width:720px;
    margin:0 0 8vh 6vw;
    padding:2rem 0;
  }

  #shopify-section-{{ section.id }} .eyebrow{
    font-size:.7rem;
    text-transform:uppercase;
    letter-spacing: var(--ls-eyebrow, 0.2em);
    margin-bottom:.9rem;
    font-weight:500;
    color:{{ section.settings.eyebrow_color }};
  }

  #shopify-section-{{ section.id }} .hero-title{
    font-family:var(--font-heading-family);
    font-weight:400;
    font-size:clamp(2.4rem,7vw,5.4rem);
    letter-spacing: var(--ls-display, -0.02em);
    line-height:1;
    margin-bottom:1.2rem;
    color:{{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .hero-title em{
    color:{{ section.settings.heading_italic_color }};
    font-style:italic;
  }

  #shopify-section-{{ section.id }} .hero-title p{
    margin:0;
  }

  #shopify-section-{{ section.id }} .hero-sub{
    color:{{ section.settings.subheading_color }};
    font-size:1.05rem;
    letter-spacing: var(--ls-body, 0);
    max-width:460px;
    margin-bottom:1.8rem;
  }

  #shopify-section-{{ section.id }} .hero-ctas{
    display:flex;
    gap:.8rem;
    flex-wrap:wrap;
  }

  #shopify-section-{{ section.id }} .btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:.95rem 1.8rem;
    border-radius:4px;
    font-size:.7rem;
    letter-spacing: var(--ls-button, 0.18em);
    text-transform:uppercase;
    font-weight:500;
    transition:all .3s ease;
    cursor:pointer;
    border:1px solid transparent;
    line-height:1;
    text-decoration:none;
  }

  #shopify-section-{{ section.id }} .btn-primary{
    background:{{ section.settings.primary_button_bg }};
    color:{{ section.settings.primary_button_text }};
    border-color:{{ section.settings.primary_button_border }};
  }

  #shopify-section-{{ section.id }} .btn-primary:hover{
    background:{{ section.settings.primary_button_hover_bg }};
    border-color:{{ section.settings.primary_button_hover_bg }};
  }

  #shopify-section-{{ section.id }} .btn-secondary{
    background:transparent;
    color:{{ section.settings.secondary_button_text }};
    border-color:{{ section.settings.secondary_button_border }};
  }

  #shopify-section-{{ section.id }} .btn-secondary:hover{
    background:{{ section.settings.secondary_button_hover_bg }};
    color:{{ section.settings.secondary_button_hover_text }};
    border-color:{{ section.settings.secondary_button_hover_bg }};
  }

  #shopify-section-{{ section.id }} .video-mute-btn{
    position:absolute;
    top:1.2rem;
    right:1.2rem;
    z-index:3;
    width:42px;
    height:42px;
    border-radius:4px;
    background:{{ section.settings.mute_button_bg }};
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    border:1px solid {{ section.settings.mute_button_border }};
    color:{{ section.settings.mute_button_icon }};
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:.3s;
  }

  #shopify-section-{{ section.id }} .video-mute-btn:hover{
    background:{{ section.settings.mute_button_hover_bg }};
  }

  #shopify-section-{{ section.id }} .video-mute-btn.muted .icon-unmute{
    display:none;
  }

  #shopify-section-{{ section.id }} .video-mute-btn:not(.muted) .icon-mute{
    display:none;
  }

  #shopify-section-{{ section.id }} .scroll-hint{
    position:absolute;
    bottom:1.5rem;
    left:50%;
    transform:translateX(-50%);
    z-index:3;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:.5rem;
    color:{{ section.settings.scroll_text_color }};
    opacity:.8;
    display:none;
  }

  #shopify-section-{{ section.id }} .scroll-hint span{
    font-size:.62rem;
    letter-spacing:.3em;
    text-transform:uppercase;
  }

  #shopify-section-{{ section.id }} .scroll-line{
    width:1px;
    height:40px;
    background:{{ section.settings.scroll_line_color }};
    animation:heroScrollPulse {{ section.settings.scroll_animation_speed }}s ease-in-out infinite;
    transform-origin:top;
  }

  @keyframes heroScrollPulse{
    0%,100%{
      transform:scaleY(.3);
      opacity:.4;
    }
    50%{
      transform:scaleY(1);
      opacity:1;
    }
  }

  @media screen and (max-width:980px){

    #shopify-section-{{ section.id }} .hero-video{
      min-height: calc(100vh - 96px);
    }

    #shopify-section-{{ section.id }} .hero-video-content{
      margin:0 0 20vh;
      padding:0 1.5rem;
    }

    #shopify-section-{{ section.id }} .hero-title{
      font-size:clamp(2.2rem,10vw,3.4rem);
    }

    #shopify-section-{{ section.id }} .hero-sub{
      font-size:.92rem;
      margin-bottom:1.2rem;
    }

    #shopify-section-{{ section.id }} .video-mute-btn{
      top:.8rem;
      right:.8rem;
      width:38px;
      height:38px;
    }
  }
</style>

{% liquid
  assign show_video = false
  assign show_image = false

  if section.settings.media_type == 'image'
    if section.settings.image != blank
      assign show_image = true
    endif
  elsif section.settings.media_type == 'video'
    if section.settings.video != blank
      assign show_video = true
    endif
  else
    if section.settings.video != blank
      assign show_video = true
    elsif section.settings.image != blank
      assign show_image = true
    endif
  endif
%}

<section class="hero-video" id="hero-{{ section.id }}" allow-transparent-header>

  {% if show_video %}
    {{
      section.settings.video
      | video_tag:
        image_size: '2000x',
        autoplay: true,
        loop: true,
        controls: false,
        playsinline: true,
        preload: 'auto',
        class: 'hero-video-bg'
    }}
  {% elsif show_image %}
    {%- if section.settings.image_mobile != blank -%}
      <picture class="hero-image-wrap">
        <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
        <img
          src="{{ section.settings.image | image_url: width: 2000 }}"
          srcset="
            {{ section.settings.image | image_url: width: 750 }} 750w,
            {{ section.settings.image | image_url: width: 1100 }} 1100w,
            {{ section.settings.image | image_url: width: 1500 }} 1500w,
            {{ section.settings.image | image_url: width: 2000 }} 2000w,
            {{ section.settings.image | image_url: width: 2800 }} 2800w
          "
          sizes="100vw"
          alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html | escape }}"
          class="hero-video-bg hero-image-bg"
          loading="eager"
          fetchpriority="high"
          width="{{ section.settings.image.width | default: 2000 }}"
          height="{{ section.settings.image.height | default: 1100 }}"
        >
      </picture>
    {%- else -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="
          {{ section.settings.image | image_url: width: 750 }} 750w,
          {{ section.settings.image | image_url: width: 1100 }} 1100w,
          {{ section.settings.image | image_url: width: 1500 }} 1500w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w,
          {{ section.settings.image | image_url: width: 2800 }} 2800w
        "
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html | escape }}"
        class="hero-video-bg hero-image-bg"
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.image.width | default: 2000 }}"
        height="{{ section.settings.image.height | default: 1100 }}"
      >
    {%- endif -%}
  {% endif %}

  <div class="hero-video-overlay"></div>

  <div class="hero-video-content">

    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">
        {% if settings.shape != blank %}
        <span class="shape">{{ settings.shape }}</span>
        {% endif %}
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <div class="hero-title">
        {{ section.settings.heading }}
      </div>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="hero-sub">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    <div class="hero-ctas">

      {% if section.settings.primary_button_label != blank %}
        <a
          href="{{ section.settings.primary_button_link }}"
          class="btn btn-primary"
        >
          {{ section.settings.primary_button_label }}
        </a>
      {% endif %}

      {% if section.settings.secondary_button_label != blank %}
        <a
          href="{{ section.settings.secondary_button_link }}"
          class="btn btn-secondary"
        >
          {{ section.settings.secondary_button_label }}
        </a>
      {% endif %}

    </div>
  </div>

  {% if section.settings.show_mute_button and show_video %}
    <button
      class="video-mute-btn muted"
      type="button"
      aria-label="Toggle sound"
    >

      <svg class="icon-mute" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M11 5 6 9H2v6h4l5 4V5z"/>
        <line x1="23" y1="9" x2="17" y2="15"/>
        <line x1="17" y1="9" x2="23" y2="15"/>
      </svg>

      <svg class="icon-unmute" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M11 5 6 9H2v6h4l5 4V5z"/>
        <path d="M15 9.5a5 5 0 0 1 0 5"/>
        <path d="M18.5 7a9 9 0 0 1 0 10"/>
      </svg>

    </button>
  {% endif %}

  {% if section.settings.show_scroll_hint %}
    <div class="scroll-hint">
      <span>{{ section.settings.scroll_text }}</span>
      <div class="scroll-line"></div>
    </div>
  {% endif %}

</section>

<script>
  (() => {

    const section = document.querySelector('#shopify-section-{{ section.id }}');

    if (!section) return;

    const video = section.querySelector('video');
    const muteButton = section.querySelector('.video-mute-btn');

    if (!video || !muteButton) return;

    video.muted = true;
    video.volume = 1;

    muteButton.addEventListener('click', async () => {

      try {

        if (video.muted) {

          video.muted = false;
          video.removeAttribute('muted');

          video.volume = 1;

          await video.play();

          muteButton.classList.remove('muted');

        } else {

          video.muted = true;
          video.setAttribute('muted', 'muted');

          muteButton.classList.add('muted');

        }

      } catch (error) {
        console.log(error);
      }

    });

  })();
</script>

