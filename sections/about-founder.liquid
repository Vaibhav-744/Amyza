{% comment %} about-founder.liquid — Founder letter + image with full-width (heritage split) or containered layout and main title {% endcomment %}

{%- liquid
  assign container = section.settings.container | default: 'fullwidth'
  if container == '1170'
    assign container_class = 'container-1170'
  elsif container == '1470'
    assign container_class = 'container-1470'
  elsif container == '1770'
    assign container_class = 'container-1770'
  elsif container == 'fullwidth'
    assign container_class = 'container-full'
  else
    assign container_class = 'container'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .about-founder {
    background: {{ section.settings.section_bg }};
    {%- if container == 'fullwidth' -%}
      padding: 0;
    {%- else -%}
      padding: clamp(3.5rem, 8vw, 6rem) 0;
    {%- endif -%}
  }
  #shopify-section-{{ section.id }} .about-founder > .container-full {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .about-founder-inner {
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    {%- if container == 'fullwidth' -%}
      gap: 0;
      align-items: stretch;
      max-width: 100%;
    {%- else -%}
      gap: clamp(2.5rem, 6vw, 5rem);
      align-items: center;
    {%- endif -%}
  }

  /* ── Text side ── */
  #shopify-section-{{ section.id }} .about-founder-text {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    {%- if container == 'fullwidth' -%}
      padding: clamp(3rem, 6vw, 6rem) 8%;
    {%- endif -%}
    {%- if section.settings.image_position == 'left' -%}
      order: 2;
    {%- endif -%}
  }
  #shopify-section-{{ section.id }} .founder-eyebrow {
    font-size: .72rem;
    letter-spacing: var(--ls-eyebrow, 0.2em);
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin-bottom: {% if section.settings.heading != blank %}.6rem{% else %}1.6rem{% endif %};
    display: block;
    font-weight: 500;
  }
  #shopify-section-{{ section.id }} .founder-heading {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.1;
    color: {{ section.settings.heading_color }};
    margin: 0 0 1.4rem;
    letter-spacing: var(--ls-title, -0.015em);
  }
  #shopify-section-{{ section.id }} .founder-heading em,
  #shopify-section-{{ section.id }} .founder-heading .serif-italic {
    color: {{ section.settings.heading_italic_color }};
  }
  #shopify-section-{{ section.id }} .founder-body {
    font-size: 1rem;
    line-height: 1.8;
    color: {{ section.settings.body_color }};
    margin-bottom: 1.2rem;
    letter-spacing: var(--ls-body, 0);
  }
  #shopify-section-{{ section.id }} .founder-body p {
    margin-bottom: 1rem;
  }
  #shopify-section-{{ section.id }} .founder-body p:last-child {
    margin-bottom: 0;
  }
  #shopify-section-{{ section.id }} .founder-closing {
    font-size: 1rem;
    color: {{ section.settings.body_color }};
    margin-top: 1.4rem;
    margin-bottom: .6rem;
    display: block;
    letter-spacing: var(--ls-body, 0);
  }
  #shopify-section-{{ section.id }} .founder-sig-img {
    display: block;
    max-height: 56px;
    width: auto;
    margin-bottom: 1.2rem;
  }
  #shopify-section-{{ section.id }} .founder-sig-text strong {
    display: block;
    font-size: .85rem;
    text-transform: uppercase;
    color: {{ section.settings.sign_name_color }};
    letter-spacing: var(--ls-meta, 0.08em);
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .founder-sig-text span {
    font-size: .82rem;
    color: {{ section.settings.sign_role_color }};
  }

  /* ── Image side ── */
  #shopify-section-{{ section.id }} .about-founder-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    {%- if container == 'fullwidth' -%}
      border-radius: 0;
      aspect-ratio: 1 / 1;
      height: 100%;
    {%- else -%}
      aspect-ratio: 1 / 1;
      border-radius: 16px;
    {%- endif -%}
    {%- if section.settings.image_position == 'left' -%}
      order: 1;
    {%- endif -%}
  }
  #shopify-section-{{ section.id }} .about-founder-media img {
    {%- if container == 'fullwidth' -%}
      position: absolute;
      inset: 0;
    {%- endif -%}
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Mobile — image always first ── */
  @media (max-width: 980px) {
    #shopify-section-{{ section.id }} .about-founder-inner {
      grid-template-columns: 1fr;
      {%- if container == 'fullwidth' -%}
        gap: 0;
      {%- else -%}
        gap: 2.2rem;
      {%- endif -%}
    }
    #shopify-section-{{ section.id }} .about-founder-media {
      order: -1 !important;
      {%- if container == 'fullwidth' -%}
        max-width: 100%;
        aspect-ratio: 1 / 1;
        height: auto;
      {%- else -%}
        max-width: 480px;
        margin: 0 auto;
        aspect-ratio: 3 / 4;
      {%- endif -%}
    }
    #shopify-section-{{ section.id }} .about-founder-text {
      order: 0 !important;
      {%- if container == 'fullwidth' -%}
        padding: 3rem 1.5rem;
      {%- endif -%}
    }
    {%- if container != 'fullwidth' -%}
      #shopify-section-{{ section.id }} .about-founder {
        padding: 3.5rem 0;
      }
    {%- endif -%}
  }
</style>

<section class="about-founder" id="about-founder-{{ section.id }}">
  <div class="{{ container_class }}">
    <div class="about-founder-inner">

      <div class="about-founder-text reveal-up">
        {%- if section.settings.eyebrow != blank -%}
          <span class="founder-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="founder-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="founder-body">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.closing != blank -%}
          <span class="founder-closing">{{ section.settings.closing }}</span>
        {%- endif -%}

        {%- if section.settings.signature_image != blank -%}
          <img
            class="founder-sig-img"
            src="{{ section.settings.signature_image | image_url: width: 300 }}"
            alt="Founder signature"
            width="150"
            height="56"
            loading="lazy"
          >
        {%- endif -%}

        <div class="founder-sig-text">
          {%- if section.settings.founder_name != blank -%}
            <strong>{{ section.settings.founder_name }}</strong>
          {%- endif -%}
          {%- if section.settings.founder_role != blank -%}
            <span>{{ section.settings.founder_role }}</span>
          {%- endif -%}
        </div>
      </div>

      <div class="about-founder-media reveal-up">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.image.alt | default: 'Founder' | escape }}"
            width="1200"
            height="1200"
            loading="lazy"
          >
        {%- else -%}
          <img
            src="https://placehold.co/900x900/F7F4F3/731157?text=Founder"
            alt="Founder"
            width="900"
            height="900"
          >
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "About — Founder",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:sections.layout.container.option",
      "default": "fullwidth",
      "options": [
        {
          "value": "container",
          "label": "t:sections.layout.container.option1"
        },
        {
          "value": "1170",
          "label": "t:sections.layout.container.option4"
        },
        {
          "value": "1470",
          "label": "t:sections.layout.container.option5"
        },
        {
          "value": "1770",
          "label": "t:sections.layout.container.option3"
        },
        {
          "value": "fullwidth",
          "label": "t:sections.layout.container.option2"
        }
      ]
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "default": "#F2EDEC",
      "info": "Default: --porcelain (#F2EDEC)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "right", "label": "Right (text left)" },
        { "value": "left",  "label": "Left (text right)" }
      ],
      "default": "left",
      "info": "On mobile, image is always shown first regardless of this setting."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Photo"
    },
    {
      "type": "header",
      "content": "Letter"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "✦ A note from our Founder"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#7D0A50"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Title",
      "default": "Glow Inherited, Modern Take"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Main Title Color",
      "default": "#9F9F46"
    },
    {
      "type": "color",
      "id": "heading_italic_color",
      "label": "Main Title Italic Color",
      "default": "#7D0A50"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body (paragraphs)",
      "default": "<p>I built AMYZA for the girl I was — the one who watched her mother and grandmother glow without a single fancy product, and wondered where that wisdom went. It never left. We just had to listen.</p><p>Those recipes were never written down. They lived in hands, in scent, in the quiet confidence of women who knew their worth. We bottled that knowing — and gave it a modern soul.</p><p>AMYZA is a love letter to ancestral botanical wisdom — bottled with bold, modern femininity for the woman who refuses to choose between heritage and now.</p>"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#5c4350"
    },
    {
      "type": "text",
      "id": "closing",
      "label": "Closing Line",
      "default": "With love,",
      "info": "e.g. With love, / With warmth, / Yours,"
    },
    {
      "type": "header",
      "content": "Signature"
    },
    {
      "type": "image_picker",
      "id": "signature_image",
      "label": "Signature Image",
      "info": "Upload a handwritten signature PNG (transparent background works best). Displayed at max 56px height."
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder Name",
      "default": "The AMYZA Founder"
    },
    {
      "type": "text",
      "id": "founder_role",
      "label": "Role / Location",
      "default": "Kuala Lumpur, Malaysia"
    },
    {
      "type": "color",
      "id": "sign_name_color",
      "label": "Name Color",
      "default": "#7D0A50"
    },
    {
      "type": "color",
      "id": "sign_role_color",
      "label": "Role Color",
      "default": "#8a7280"
    }
  ],
  "presets": [
    {
      "name": "About — Founder"
    }
  ]
}
{% endschema %}
