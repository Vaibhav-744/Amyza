{% comment %} botanicals.liquid {% endcomment %}

<style>
  /* ── Section ── */
  #shopify-section-{{ section.id }} .botanicals {
    position: relative;
    background-color: {{ section.settings.section_bg }};
    {%- if section.settings.section_bg_image != blank -%}
      background-image: url('{{ section.settings.section_bg_image | image_url: width: 2500 }}');
      background-size: {{ section.settings.bg_image_size | default: 'cover' }};
      background-position: {{ section.settings.bg_image_position | default: 'center center' }};
      background-repeat: {{ section.settings.bg_image_repeat | default: 'no-repeat' }};
    {%- else -%}
      background: {{ section.settings.section_bg }};
    {%- endif -%}
    color: {{ section.settings.section_text_color }};
    padding: 5rem 2rem;
  }

  {%- if section.settings.section_bg_image != blank and section.settings.bg_overlay_opacity > 0 -%}
    #shopify-section-{{ section.id }} .botanicals::before {
      content: '';
      position: absolute;
      inset: 0;
      background-color: {{ section.settings.bg_overlay_color | default: '#000000' }};
      opacity: {{ section.settings.bg_overlay_opacity | divided_by: 100.0 }};
      pointer-events: none;
      z-index: 0;
    }
    #shopify-section-{{ section.id }} .botanicals > * {
      position: relative;
      z-index: 1;
    }
  {%- endif -%}

  {%- if section.settings.section_bg_image_mobile != blank -%}
    @media (max-width: 768px) {
      #shopify-section-{{ section.id }} .botanicals {
        background-image: url('{{ section.settings.section_bg_image_mobile | image_url: width: 1200 }}');
      }
    }
  {%- endif -%}

  /* ── Cards ── */
  #shopify-section-{{ section.id }} .botanical-card {
    background: rgba(242, 237, 236,.06);
    border: 1px solid rgba(242, 237, 236,.15);
    border-radius: var(--radius-md);
    padding: 1.2rem;
    transition: .4s;
  }
  #shopify-section-{{ section.id }} .botanical-card:hover {
    background: rgba(242, 237, 236,.1);
    transform: translateY(-5px);
  }

  /* ── Botanical image ── */
  #shopify-section-{{ section.id }} .botanical-image_wrapper{
    height: auto;
    position: relative;
    background: transparent;
    aspect-ratio: 1 / 1;
    Width: 100%;
    margin-bottom:1.1rem;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .botanical-img {
    background-color:transparent;
    border-radius: var(--radius-sm);
    margin-bottom: .8rem;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;

  }

  /* ── Card text ── */
  #shopify-section-{{ section.id }} .botanical-card h3 {
    font-family: var(--serif);
    font-style: italic;
    margin-bottom: .3rem;
    color: {{ section.settings.card_title_color }};
    font-size: 1.2rem;
    letter-spacing: var(--ls-heading, -0.01em);
  }
  #shopify-section-{{ section.id }} .botanical-card p {
    font-size: .82rem;
    opacity: .85;
    color: {{ section.settings.card_desc_color }};
    letter-spacing: var(--ls-body, 0);
  }

  /* ── Section header overrides (light variant) ── */
  #shopify-section-{{ section.id }} .eyebrow {
    color: {{ section.settings.eyebrow_color }};
  }

  #shopify-section-{{ section.id }} .section-header h2 {
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .section-header h2 em,
  #shopify-section-{{ section.id }} .section-header h2 .serif-italic {
    color: {{ section.settings.heading_italic_color }};
  }

  #shopify-section-{{ section.id }} .section-sub {
    color: {{ section.settings.subheading_color }};
  }

  #shopify-section-{{ section.id }} .botanicals-btn-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  #shopify-section-{{ section.id }} .botanicals-btn {
    display: inline-block;
    padding: .95rem 1.8rem;
    border-radius: 4px;
    font-size: .7rem;
    letter-spacing: var(--ls-button, 0.18em);
    text-transform: uppercase;
    font-weight: 500;
    transition: .3s;
    cursor: pointer;
    line-height: 1;
    text-decoration: none;
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text_color }};
  }
  #shopify-section-{{ section.id }} .botanicals-btn:hover {
    background: {{ section.settings.btn_hover_bg }};
  }
  @media(max-width:980px){
    #shopify-section-{{ section.id }} .botanicals {
        padding: 3.5rem 1.2rem;
    }
  }
</style>

<section class="botanicals" id="botanicals">
  <div class="section-header light reveal-up">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <div>{{ section.settings.heading }}</div>
    <p class="section-sub">{{ section.settings.subheading }}</p>
  </div>

  <div class="carousel dark" data-carousel="botanicals">
    <button class="carousel-btn prev" aria-label="Previous">←</button>
    <div class="carousel-viewport">
      <div class="carousel-track">
        {% for block in section.blocks %}
          <div class="botanical-card carousel-slide" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="botanical-image_wrapper">
              <img
                class="botanical-img"
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                width="600"
                height="600"
                loading="lazy"
              />
            </div>
            {% else %}
              <div class="botanical-img" style="background: {{ block.settings.fallback_bg }};"></div>
            {% endif %}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
    <button class="carousel-btn next" aria-label="Next">→</button>
    <div class="carousel-dots" aria-hidden="true"></div>
    {% if section.settings.btn_text != blank %}
      <div class="botanicals-btn-wrap">
        <a
          href="{{ section.settings.btn_url }}"
          class="botanicals-btn">
          {{ section.settings.btn_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

