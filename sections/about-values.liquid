      "info": "Default: --porcelain-soft"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "✦ What We Stand For"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#731157"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Five quiet promises."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2A0A20"
    },
    {
      "type": "color",
      "id": "heading_italic_color",
      "label": "Heading Italic Color",
      "default": "#731157"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The principles behind every drop."
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Subheading Color",
      "default": "#7a6270"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#F1EDEC"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card Border",
      "default": "#ead9e4"
    },
    {
      "type": "color",
      "id": "num_color",
      "label": "Number Color",
      "default": "#EAACC9",
      "info": "Default: --blush (#EAACC9)"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#731157"
    },
    {
      "type": "color",
      "id": "card_body_color",
      "label": "Card Body Color",
      "default": "#6a5260"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon Image",
          "info": "Max display size: 100px. If set, the number is hidden."
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01",
          "info": "Shown only when no image is uploaded."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Heritage First"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Description",
          "default": "Every formula begins with a recipe treasured for generations, then validated by modern science."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "number": "01",
            "title": "Heritage First",
            "body": "Every formula begins with a recipe treasured for generations, then validated by modern science."
          }
        },
        {
          "type": "value",
          "settings": {
            "number": "02",
            "title": "Slow by Design",
            "body": "We make in small, intentional batches. No shortcuts, no fillers, no rush."
          }
        },
        {
          "type": "value",
          "settings": {
            "number": "03",
            "title": "Bold Femininity",
