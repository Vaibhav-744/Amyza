          }
        },
        {
          "type": "value",
          "settings": {
            "number": "04",
            "title": "Clean & Kind",
            "body": "Cruelty-free, paraben-free, alcohol-free. Kind to your skin, kinder to the planet."
          }
        },
        {
          "type": "value",
          "settings": {
            "number": "05",
            "title": "Made in Malaysia",
            "body": "Proudly crafted at home, bridging South Asian roots with Malaysian botanical heroes."
          }
        }
      ]
    }
