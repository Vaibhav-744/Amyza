{% comment %} contact-page.liquid {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .contact-page-wrapper {
    background: {{ section.settings.section_bg }};
    color: {{ section.settings.text_color }};
  }

  /* ========== HERO ========== */
  #shopify-section-{{ section.id }} .contact-hero {
    background: {{ section.settings.hero_bg_gradient }};
    padding: 8rem 6vw 4rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .contact-hero .eyebrow {
    color: {{ section.settings.eyebrow_color }};
  }

  #shopify-section-{{ section.id }} .contact-hero h1 {
    font-family: var(--serif, 'Instrument Serif', Georgia, serif);
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    color: {{ section.settings.hero_heading_color }};
    line-height: 1.02;
    font-weight: 400;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .contact-hero h1 .serif-italic,
  #shopify-section-{{ section.id }} .contact-hero h1 em {
    font-family: var(--serif, 'Instrument Serif', Georgia, serif);
    font-style: italic;
    color: {{ section.settings.hero_heading_italic_color }};
  }

  #shopify-section-{{ section.id }} .contact-hero p.hero-desc {
    max-width: 520px;
    margin: 1.3rem auto 0;
    color: {{ section.settings.hero_text_color }};
    font-size: 1.05rem;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .contact-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(8px);
    opacity: .55;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .contact-orb.o1 {
    width: 200px;
    height: 200px;
    background: var(--plum, #731157);
    left: 6%;
    top: 20%;
    animation: float-orb-{{ section.id }} 9s ease-in-out infinite;
  }

  #shopify-section-{{ section.id }} .contact-orb.o2 {
    width: 140px;
    height: 140px;
    background: var(--olive, #9F9F46);
    right: 8%;
    bottom: 14%;
    animation: float-orb-{{ section.id }} 11s ease-in-out infinite reverse;
  }

  @keyframes float-orb-{{ section.id }} {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-26px); }
  }

  /* ========== BODY ========== */
  #shopify-section-{{ section.id }} .contact-body {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    padding: 4rem 5vw;
    max-width: 1300px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  #shopify-section-{{ section.id }} .field {
    display: flex;
    flex-direction: column;
    gap: .45rem;
  }

  #shopify-section-{{ section.id }} .field label {
    font-size: .72rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--plum, #731157);
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .field input,
  #shopify-section-{{ section.id }} .field textarea,
  #shopify-section-{{ section.id }} .field select {
    font-family: var(--sans, 'Public Sans', system-ui, sans-serif);
    font-size: .95rem;
    color: var(--ink, #2A0A20);
    background: {{ section.settings.input_bg }};
    border: 1px solid rgba(115,17,87,.18);
    border-radius: 12px;
    padding: .9rem 1rem;
    transition: border-color .3s, box-shadow .3s;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .field input:focus,
  #shopify-section-{{ section.id }} .field textarea:focus,
  #shopify-section-{{ section.id }} .field select:focus {
    outline: none;
    border-color: var(--plum, #731157);
    box-shadow: 0 0 0 3px rgba(115,17,87,.1);
  }

  #shopify-section-{{ section.id }} .field textarea {
    resize: vertical;
    min-height: 130px;
  }

  #shopify-section-{{ section.id }} .contact-form .btn-submit {
    align-self: flex-start;
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_color }};
    border: 1px solid transparent;
    padding: .95rem 1.8rem;
    border-radius: var(--radius-md, 4px);
    font-size: .7rem;
    letter-spacing: .24em;
    text-transform: uppercase;
    font-weight: 500;
    cursor: pointer;
    line-height: 1;
    font-family: var(--sans, 'Public Sans', system-ui, sans-serif);
    transition: background .3s, transform .3s, box-shadow .3s;
  }

  #shopify-section-{{ section.id }} .contact-form .btn-submit:hover {
    background: {{ section.settings.btn_hover_bg }};
  }

  #shopify-section-{{ section.id }} .form-status {
    font-size: .85rem;
    min-height: 1.2em;
    margin-top: .5rem;
  }

  #shopify-section-{{ section.id }} .form-status.ok,
  #shopify-section-{{ section.id }} .form-status--success {
    color: var(--emerald, #1D4F3B);
  }

  #shopify-section-{{ section.id }} .form-status.err,
  #shopify-section-{{ section.id }} .form-status--error {
    color: #b3306b;
  }

  /* ========== INFO CARDS ========== */
  #shopify-section-{{ section.id }} .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .info-card {
    background: {{ section.settings.card_bg }};
    border: 1px solid rgba(115,17,87,.1);
    border-radius: 16px;
    padding: 1.4rem 1.5rem;
    transition: transform .35s, box-shadow .35s;
  }

  #shopify-section-{{ section.id }} .info-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 36px rgba(115,17,87,.1);
  }

  #shopify-section-{{ section.id }} .info-card h4 {
    font-family: var(--serif, 'Instrument Serif', Georgia, serif);
    font-size: 1.2rem;
    color: var(--plum, #731157);
    margin-bottom: .35rem;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .info-card p,
  #shopify-section-{{ section.id }} .info-card a {
    color: #5a4350;
    font-size: .9rem;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .info-card a {
    color: var(--plum, #731157);
    transition: opacity .3s;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .info-card a:hover {
    opacity: .7;
  }

  #shopify-section-{{ section.id }} .info-card .socials {
    display: flex;
    gap: 1rem;
    margin-top: .3rem;
  }

  /* ========== FAQ ACCORDION ========== */
  #shopify-section-{{ section.id }} .contact-faq {
    padding: 1rem 6vw 4rem;
    max-width: 820px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .contact-faq h2 {
    font-family: var(--serif, 'Instrument Serif', Georgia, serif);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--plum, #731157);
    text-align: center;
    margin-bottom: 2rem;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .contact-faq h2 .serif-italic,
  #shopify-section-{{ section.id }} .contact-faq h2 em {
    font-style: italic;
  }

  #shopify-section-{{ section.id }} .pdp-accordion {
    border-top: 1px solid rgba(115,17,87,.14);
  }

  #shopify-section-{{ section.id }} .pdp-accordion details {
    border-bottom: 1px solid rgba(115,17,87,.14);
  }

  #shopify-section-{{ section.id }} .pdp-accordion summary {
    list-style: none;
    cursor: pointer;
    padding: 1.1rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: .95rem;
    color: var(--ink, #2A0A20);
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .pdp-accordion summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .pdp-accordion summary::after {
    content: '+';
    color: var(--plum, #731157);
    font-size: 1.3rem;
    transition: transform .3s;
  }

  #shopify-section-{{ section.id }} .pdp-accordion details[open] summary::after {
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .pdp-accordion .acc-body {
    padding: 0 0 1.2rem;
    color: #5a4350;
    line-height: 1.7;
    font-size: .9rem;
  }

  /* Responsive */
  @media (max-width: 980px) {
    #shopify-section-{{ section.id }} .contact-body {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .contact-hero {
      padding-top: 7rem;
    }
  }
</style>

<div class="contact-page-wrapper">
  <!-- ========== CONTACT HERO ========== -->
  <section class="contact-hero">
    <span class="contact-orb o1" aria-hidden="true"></span>
    <span class="contact-orb o2" aria-hidden="true"></span>
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow" data-rise>{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 data-rise="scale">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="hero-desc">{{ section.settings.subheading }}</p>
    {% endif %}
  </section>

  <!-- ========== CONTACT BODY ========== -->
  <section class="contact-body">
    {% form 'contact', id: 'contactForm', class: 'contact-form' %}
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success ok" role="status" tabindex="-1" autofocus>
          {{ 'templates.contact.form.post_success' | t | default: "Thank you! Your message is on its way — we'll reply within a day." }}
        </p>
      {%- elsif form.errors -%}
        <div class="form-status form-status--error err" role="alert" tabindex="-1" autofocus>
          <p class="form-message">
            {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
          </p>
        </div>
      {%- endif -%}

      <div class="field">
        <label for="cf-name-{{ section.id }}">{{ section.settings.form_name_label }}</label>
        <input
          type="text"
          id="cf-name-{{ section.id }}"
          name="contact[{{ 'templates.contact.form.name' | t | default: 'name' }}]"
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          placeholder="{{ section.settings.form_name_placeholder }}"
          required
        >
      </div>

      <div class="field">
        <label for="cf-email-{{ section.id }}">{{ section.settings.form_email_label }}</label>
        <input
          type="email"
          id="cf-email-{{ section.id }}"
          name="contact[email]"
          spellcheck="false"
          autocomplete="email"
          autocapitalize="off"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          placeholder="{{ section.settings.form_email_placeholder }}"
          required
        >
      </div>

      <div class="field">
        <label for="cf-topic-{{ section.id }}">{{ section.settings.form_topic_label }}</label>
        <select id="cf-topic-{{ section.id }}" name="contact[Topic]" required>
          <option value="">Choose a topic…</option>
          <option value="Skincare advice">Skincare advice</option>
          <option value="My order">My order</option>
          <option value="Returns & shipping">Returns &amp; shipping</option>
          <option value="Wholesale / press">Wholesale / press</option>
          <option value="Something else">Something else</option>
        </select>
      </div>

      <div class="field">
        <label for="cf-message-{{ section.id }}">{{ section.settings.form_message_label }}</label>
        <textarea
          id="cf-message-{{ section.id }}"
          name="contact[body]"
          placeholder="{{ section.settings.form_message_placeholder }}"
          required
        >{{- form.body -}}</textarea>
      </div>

      <button type="submit" class="btn-submit magnetic">
        {{ section.settings.form_button_label }}
      </button>
    {% endform %}

    <aside class="contact-info">
      {% for block in section.blocks %}
        {% if block.type == 'info_card' %}
          <div class="info-card tilt" {{ block.shopify_attributes }}>
            {% if block.settings.title != blank %}
              <h4>{{ block.settings.title }}</h4>
            {% endif %}

            {% if block.settings.link_text != blank %}
              <p>
                <a href="{{ block.settings.link_url | default: '#' }}">{{ block.settings.link_text }}</a>
              </p>
            {% endif %}

            {% if block.settings.content != blank %}
              {{ block.settings.content }}
            {% endif %}

            {% if block.settings.show_socials %}
              <div class="socials">
                {% if settings.social_instagram_link != blank or block.settings.instagram_url != blank %}
                  <a href="{{ block.settings.instagram_url | default: settings.social_instagram_link | default: '#' }}">Instagram</a>
                {% endif %}
                {% if settings.social_tiktok_link != blank or block.settings.tiktok_url != blank %}
                  <a href="{{ block.settings.tiktok_url | default: settings.social_tiktok_link | default: '#' }}">TikTok</a>
                {% endif %}
                {% if settings.social_youtube_link != blank or block.settings.youtube_url != blank %}
                  <a href="{{ block.settings.youtube_url | default: settings.social_youtube_link | default: '#' }}">YouTube</a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </aside>
  </section>

  <!-- ========== FAQ ========== -->
  {% if section.settings.show_faq %}
    <section class="contact-faq">
      {% if section.settings.faq_heading != blank %}
        <h2 data-rise>{{ section.settings.faq_heading }}</h2>
      {% endif %}

      <div class="pdp-accordion">
        {% for block in section.blocks %}
          {% if block.type == 'faq_item' %}
            <details {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="acc-body">
                {{ block.settings.answer }}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}
</div>

