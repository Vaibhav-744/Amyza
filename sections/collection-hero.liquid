{% comment %} collection-hero.liquid {% endcomment %}

<style>
  /* ── Section shell — no background color, displays background image ── */
  #shopify-section-{{ section.id }} .collection-hero {
    background: transparent;
    color: var(--porcelain);
    padding: {{ section.settings.padding_desktop }}rem 0 {{ section.settings.padding_bottom_desktop }}rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  /* ── Background Image ── */
  #shopify-section-{{ section.id }} .collection-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .collection-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.bg_position | default: 'center center' }};
    display: block;
  }

  #shopify-section-{{ section.id }} .collection-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: {{ section.settings.overlay_color | default: '#000000' }};
  }

  /* ── Content container (centered text) ── */
  #shopify-section-{{ section.id }} .collection-hero__content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── Eyebrow ── */
  #shopify-section-{{ section.id }} .collection-hero .eyebrow {
    color: {{ section.settings.eyebrow_color }};
  }

  /* ── Heading ── */
  #shopify-section-{{ section.id }} .collection-hero .ch-heading {
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    color: var(--porcelain);
    line-height: 1.05;
  }

  #shopify-section-{{ section.id }} .collection-hero .ch-heading .serif-italic,
  #shopify-section-{{ section.id }} .collection-hero .ch-heading em {
    font-family: var(--serif, 'Instrument Serif', Georgia, serif);
    font-style: italic;
    color: {{ section.settings.heading_italic_color }};
  }

  /* ── Subtext ── */
  #shopify-section-{{ section.id }} .collection-hero .ch-sub {
    max-width: 560px;
    margin: 1rem auto 0;
    color: rgba(242, 237, 236, .82);
    font-size: 1.02rem;
    line-height: 1.5;
  }

  /* ── Marquee wrapper — full width uncontainered edge-to-edge ── */
  #shopify-section-{{ section.id }} .ingredient-marquee {
    margin-top: 1.8rem;
    width: 100%;
    overflow: hidden;
    position: relative;
    z-index: 1;
    padding: 0.75rem 0;
    border-top: 1px solid {{ section.settings.marquee_separator_color | default: 'rgba(234, 172, 201, 0.25)' }};
    border-bottom: 1px solid {{ section.settings.marquee_separator_color | default: 'rgba(234, 172, 201, 0.25)' }};
  }

  /* ── Track ── */
  #shopify-section-{{ section.id }} .ingredient-marquee .marquee-track {
    display: inline-flex;
    gap: 3rem;
    white-space: nowrap;
    width: max-content;
    animation: amyza-marquee-{{ section.id }} {{ section.settings.marquee_speed }}s linear infinite;
  }

  {% if section.settings.pause_on_hover %}
  #shopify-section-{{ section.id }} .ingredient-marquee .marquee-track:hover {
    animation-play-state: paused;
  }
  {% endif %}

  @keyframes amyza-marquee-{{ section.id }} {
    to { transform: translateX(-50%); }
  }

  /* ── Individual ingredient items ── */
  #shopify-section-{{ section.id }} .ingredient-marquee .marquee-track span {
    font-family: var(--serif, 'Instrument Serif', Georgia, serif);
    font-style: italic;
    font-size: 1.3rem;
    color: {{ section.settings.marquee_text_color }};
    flex-shrink: 0;
  }

  /* ── Separator ── */
  #shopify-section-{{ section.id }} .ingredient-marquee .marquee-track span::after {
    content: '✦';
    margin-left: 3rem;
    color: {{ section.settings.marquee_separator_color }};
    font-style: normal;
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .collection-hero {
      padding-top: 5.5rem;
      padding-bottom: 0;
    }
    #shopify-section-{{ section.id }} .collection-hero .ch-heading {
      font-size: clamp(2rem, 8vw, 2.8rem);
    }
    #shopify-section-{{ section.id }} .collection-hero .ch-sub {
      font-size: .95rem;
    }
    #shopify-section-{{ section.id }} .ingredient-marquee {
      padding: 0.6rem 0;
      margin-top: 1.4rem;
    }
    #shopify-section-{{ section.id }} .ingredient-marquee .marquee-track span {
      font-size: 1.05rem;
    }
  }
</style>

{%- assign hero_image = section.settings.bg_image | default: collection.image -%}

<section class="collection-hero" id="collection-hero-{{ section.id }}">

  {%- if hero_image != blank -%}
    <div class="collection-hero__bg" aria-hidden="true">
      <picture>
        {%- if section.settings.bg_image_mobile != blank -%}
          <source media="(max-width: 767px)" srcset="{{ section.settings.bg_image_mobile | img_url: '1000x' }}">
        {%- endif -%}
        <img
          src="{{ hero_image | img_url: '2048x' }}"
          alt="{{ hero_image.alt | default: collection.title | escape }}"
          class="collection-hero__bg-img"
          loading="eager"
          width="{{ hero_image.width }}"
          height="{{ hero_image.height }}"
        >
      </picture>
      {%- if section.settings.overlay_opacity > 0 -%}
        <div class="collection-hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="collection-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow reveal-up">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <{{ section.settings.heading_tag }} class="ch-heading reveal-up">
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {% endif %}

    {% if section.settings.subtext != blank %}
      <p class="ch-sub reveal-up">{{ section.settings.subtext }}</p>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="ingredient-marquee" aria-hidden="true">
      <div class="marquee-track">
        {% for i in (1..4) %}
          {% for block in section.blocks %}
            <span {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

</section>

{% schema %}
{
  "name": "Collection Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image",
      "info": "Leave blank to use the collection's featured image"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Image Position",
      "options": [
        { "value": "center center", "label": "Center Center" },
        { "value": "top center", "label": "Top Center" },
        { "value": "bottom center", "label": "Bottom Center" }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Darkness (%)",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Top Padding — Desktop (rem)",
      "min": 2,
      "max": 14,
      "step": 0.5,
      "unit": "rem",
      "default": 6.5
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom Padding — Desktop (rem)",
      "min": 0,
      "max": 8,
      "step": 0.5,
      "unit": "rem",
      "default": 1
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#F0AEBC"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap italic words in <em> — they use the Italic Color below.",
      "default": "<p>Every <em>Ritual.<\/em><\/p>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        { "value": "h1", "label": "H1 (use on collection page)" },
        { "value": "h2", "label": "H2 (use on homepage)" }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "heading_italic_color",
      "label": "Heading Italic Color",
      "default": "#F0AEBC"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Slow-luxury skincare rooted in ancestral botanical wisdom — crafted in small batches, made for the woman who knows her worth."
    },
    {
      "type": "header",
      "content": "Ingredient Marquee"
    },
    {
      "type": "color",
      "id": "marquee_text_color",
      "label": "Ingredient Text Color",
      "default": "#F0AEBC"
    },
    {
      "type": "color",
      "id": "marquee_separator_color",
      "label": "Separator & Border Color",
      "default": "rgba(240, 174, 188, 0.4)"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee Speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "default": 26
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Ingredient Name",
          "default": "Saffron"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Hero",
      "blocks": [
        { "type": "ingredient", "settings": { "label": "Saffron" } },
        { "type": "ingredient", "settings": { "label": "Rose" } },
        { "type": "ingredient", "settings": { "label": "Jasmine" } },
        { "type": "ingredient", "settings": { "label": "Turmeric" } },
        { "type": "ingredient", "settings": { "label": "Pegaga" } },
        { "type": "ingredient", "settings": { "label": "Tremella" } }
      ]
    }
  ]
}
{% endschema %}
