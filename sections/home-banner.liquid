      "default": "linear-gradient(180deg, rgba(42,10,32,0.30) 0%, rgba(78,10,58,0.55) 60%, rgba(42,10,32,0.72) 100%)"
    },
    {
      "type": "range",
      "id": "min_height_desktop",
