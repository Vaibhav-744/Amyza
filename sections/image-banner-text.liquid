{% comment %} image-banner-text.liquid — Full-width image banner with text overlay {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .ibt-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: {{ section.settings.fallback_bg }};
    aspect-ratio: {{ section.settings.aspect_ratio }};
  }

  /* ── Background image ── */
  #shopify-section-{{ section.id }} .ibt-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.focal_point }};
    display: block;
    z-index: 0;
  }

  /* ── Overlay ── */
  #shopify-section-{{ section.id }} .ibt-overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay }};
    z-index: 1;
    pointer-events: none;
  }

  /* ── Content ── */
  #shopify-section-{{ section.id }} .ibt-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.align_x }};
    justify-content: {{ section.settings.align_y }};
    padding: clamp(2rem, 6vw, 5rem) 6vw;
    text-align: {{ section.settings.text_align }};
  }
  #shopify-section-{{ section.id }} .ibt-eyebrow {
    display: block;
    font-size: .72rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin-bottom: 1rem;
  }
  #shopify-section-{{ section.id }} .ibt-heading {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp({{ section.settings.heading_size_min }}rem, 5vw, {{ section.settings.heading_size_max }}rem);
    line-height: 1.06;
    color: {{ section.settings.heading_color }};
    max-width: 18ch;
    margin-bottom: 1.2rem;
  }
  #shopify-section-{{ section.id }} .ibt-heading em {
    color: {{ section.settings.heading_italic_color }};
  }
  #shopify-section-{{ section.id }} .ibt-sub {
    font-size: clamp(.95rem, 1.4vw, 1.1rem);
    line-height: 1.7;
    color: {{ section.settings.sub_color }};
    max-width: 52ch;
    margin-bottom: 2rem;
  }
  #shopify-section-{{ section.id }} .ibt-btns {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
    justify-content: {%- if section.settings.text_align == 'center' -%}center{%- else -%}flex-start{%- endif -%};
  }
  #shopify-section-{{ section.id }} .ibt-btn {
    display: inline-block;
    text-decoration: none;
    padding: .95rem 1.8rem;
    border-radius: var(--radius-md);
    font-size: .7rem;
    letter-spacing: .24em;
    text-transform: uppercase;
    font-weight: 500;
    font-family: var(--sans);
    line-height: 1;
    transition: background .3s, color .3s, border-color .3s, transform .3s;
    border: 1px solid transparent;
  }
  #shopify-section-{{ section.id }} .ibt-btn-primary {
    background: {{ section.settings.btn1_bg }};
    color: {{ section.settings.btn1_text_color }};
    border-color: {{ section.settings.btn1_bg }};
  }
  #shopify-section-{{ section.id }} .ibt-btn-primary:hover {
    background: {{ section.settings.btn1_hover_bg }};
    border-color: {{ section.settings.btn1_hover_bg }};
    transform: translateY(-2px);
  }
  #shopify-section-{{ section.id }} .ibt-btn-secondary {
    background: transparent;
    color: {{ section.settings.btn2_color }};
    border-color: {{ section.settings.btn2_color }};
  }
  #shopify-section-{{ section.id }} .ibt-btn-secondary:hover {
    background: {{ section.settings.btn2_color }};
    color: {{ section.settings.btn1_bg }};
    transform: translateY(-2px);
  }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .ibt-section {
      aspect-ratio: 3/4;
    }
  }
  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .ibt-section {
      aspect-ratio: 4/5;
    }
    #shopify-section-{{ section.id }} .ibt-btns {
      flex-direction: column;
      align-items: stretch;
    }
    #shopify-section-{{ section.id }} .ibt-btn {
      text-align: center;
    }
  }
</style>

<section class="ibt-section" id="ibt-{{ section.id }}">

  {%- if section.settings.image != blank -%}
    <img
      class="ibt-img"
      src="{{ section.settings.image | image_url: width: 2400 }}"
      alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
      width="2400"
      height="1350"
      loading="lazy"
    >
  {%- endif -%}

  <div class="ibt-overlay"></div>

  <div class="ibt-content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="ibt-eyebrow" data-rise>{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="ibt-heading" data-split>{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="ibt-sub" data-rise>{{ section.settings.subtext }}</p>
    {%- endif -%}

    <div class="ibt-btns">
      {%- if section.settings.btn1_text != blank -%}
        <a href="{{ section.settings.btn1_url | default: '#' }}" class="ibt-btn ibt-btn-primary">
          {{ section.settings.btn1_text }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn2_text != blank -%}
        <a href="{{ section.settings.btn2_url | default: '#' }}" class="ibt-btn ibt-btn-secondary">
          {{ section.settings.btn2_text }}
        </a>
      {%- endif -%}
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Image Banner — Text",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "fallback_bg",
      "label": "Fallback Background",
      "default": "#2A0A20"
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Image Focal Point",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center",    "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "center left",   "label": "Left" },
        { "value": "center right",  "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Desktop Aspect Ratio",
      "options": [
        { "value": "21/9", "label": "21:9 — Cinematic" },
        { "value": "16/6", "label": "16:6 — Wide banner" },
        { "value": "16/9", "label": "16:9 — Widescreen" },
        { "value": "4/3",  "label": "4:3 — Classic" },
        { "value": "1/1",  "label": "1:1 — Square" }
      ],
      "default": "16/6"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color_background",
      "id": "overlay",
      "label": "Overlay",
      "default": "linear-gradient(180deg, rgba(42,10,32,0.20) 0%, rgba(42,10,32,0.58) 100%)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "align_x",
      "label": "Horizontal Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center",     "label": "Center" },
        { "value": "flex-end",   "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "align_y",
      "label": "Vertical Alignment",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center",     "label": "Middle" },
        { "value": "flex-end",   "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Align",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Leave blank to hide."
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#EAACC9"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beauty, rooted in ritual."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#F1EDEC"
    },
    {
      "type": "color",
      "id": "heading_italic_color",
      "label": "Heading Italic Color",
      "default": "#EAACC9",
      "info": "Wrap words in <em> to use this color."
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "label": "Heading Size — Mobile (rem)",
      "min": 1,
      "max": 4,
      "step": 0.1,
      "default": 2.2
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "label": "Heading Size — Desktop (rem)",
      "min": 2,
      "max": 8,
      "step": 0.1,
      "default": 4.4
    },
    {
      "type": "header",
      "content": "Subtext"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "info": "Leave blank to hide."
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Subtext Color",
      "default": "rgba(241,237,236,0.85)"
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "info": "Leave blank to hide."
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 URL"
    },
    {
      "type": "color",
      "id": "btn1_bg",
      "label": "Background",
      "default": "#731157"
    },
    {
      "type": "color",
      "id": "btn1_text_color",
      "label": "Text Color",
      "default": "#F1EDEC"
    },
    {
      "type": "color",
      "id": "btn1_hover_bg",
      "label": "Hover Background",
      "default": "#4E0A3A"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "info": "Leave blank to hide."
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 URL"
    },
    {
      "type": "color",
      "id": "btn2_color",
      "label": "Color",
      "default": "#F1EDEC"
    }
  ],
  "presets": [
    {
      "name": "Image Banner — Text"
    }
  ]
}
{% endschema %}
