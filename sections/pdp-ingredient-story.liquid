{% comment %} pdp-ingredient-story.liquid — Pinned ingredient scroll story {% endcomment %}

<style>
  /* ── Layout ── */
  #shopify-section-{{ section.id }} .ingredient-story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: {{ section.settings.section_bg }};
    color: var(--porcelain);
  }
  #shopify-section-{{ section.id }} .ing-visual {
    position: sticky;
    top: 0;
    height: 100vh;
    background-color: {{ section.settings.section_bg }};
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: background-image .8s ease, opacity .8s ease;
  }
  #shopify-section-{{ section.id }} .ing-steps {
    padding: 4rem 5vw;
  }
  #shopify-section-{{ section.id }} .ing-step {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: .35;
    transition: opacity .6s ease;
  }
  #shopify-section-{{ section.id }} .ing-step.ing-on {
    opacity: 1;
  }

  /* ── Step text ── */
  #shopify-section-{{ section.id }} .ing-step .eyebrow {
    color: {{ section.settings.eyebrow_color }};
  }
  #shopify-section-{{ section.id }} .ing-step h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.2rem);
    color: {{ section.settings.heading_color }};
    line-height: 1.1;
  }
  #shopify-section-{{ section.id }} .ing-step h2 em,
  #shopify-section-{{ section.id }} .ing-step h2 .serif-italic {
    color: {{ section.settings.heading_italic_color }};
  }
  #shopify-section-{{ section.id }} .ing-step p {
    color: {{ section.settings.body_color }};
    line-height: 1.7;
    margin-top: 1rem;
    max-width: 44ch;
  }

  /* ── Responsive ── */
  @media (max-width: 980px) {
    #shopify-section-{{ section.id }} .ingredient-story {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .ing-visual {
      height: 50vh;
      position: static;
    }
    #shopify-section-{{ section.id }} .ing-step {
      min-height: auto;
      padding: 2rem 0;
      opacity: 1;
    }
  }
</style>

<div class="ingredient-story" id="ing-story-{{ section.id }}">

  <div
    class="ing-visual"
    id="ing-visual-{{ section.id }}"
    {%- if section.blocks.first.settings.image != blank -%}
      style="background-image: url({{ section.blocks.first.settings.image | image_url: width: 1400 }});"
    {%- endif -%}
  ></div>

  <div class="ing-steps">
    {%- for block in section.blocks -%}
      <div
        class="ing-step"
        data-bg="{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1400 }}{%- endif -%}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ block.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2 data-split>{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.body != blank -%}
          {{ block.settings.body }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

</div>

<script>
  (function () {
    var wrap   = document.getElementById('ing-story-{{ section.id }}');
    if (!wrap) return;
    var visual = document.getElementById('ing-visual-{{ section.id }}');
    var steps  = wrap.querySelectorAll('.ing-step');
    if (!visual || !steps.length) return;

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          var bg = entry.target.dataset.bg;
          if (bg) visual.style.backgroundImage = 'url(' + bg + ')';
          entry.target.classList.add('ing-on');
        } else {
          entry.target.classList.remove('ing-on');
        }
      });
    }, { threshold: 0.35 });

    steps.forEach(function (s) { io.observe(s); });
  })();
</script>

{% schema %}
{
  "name": "PDP — Ingredient Story",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "default": "#4E0A3A",
      "info": "Default: --plum-deep"
    },
    {
      "type": "header",
      "content": "Step Colors"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#EAACC9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#F1EDEC"
    },
    {
      "type": "color",
      "id": "heading_italic_color",
      "label": "Heading Italic Color",
      "default": "#EAACC9"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Color",
      "default": "rgba(241,237,236,0.78)"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Ingredient Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Visual Image",
          "info": "Shown in the sticky left panel when this step scrolls into view."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "✦ The Golden Thread"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Saffron, the heirloom radiance."
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>More precious by weight than gold, saffron has crossed kitchens, temples and dressing tables for over three thousand years. In AMYZA, it does what it has always done — coaxes a quiet, lit-from-within glow that no highlighter can fake.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP — Ingredient Story",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "eyebrow": "✦ The Golden Thread",
            "heading": "Saffron, the heirloom radiance.",
            "body": "<p>More precious by weight than gold, saffron has crossed kitchens, temples and dressing tables for over three thousand years. In AMYZA, it does what it has always done — coaxes a quiet, lit-from-within glow that no highlighter can fake.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "eyebrow": "✦ The Floral Heart",
            "heading": "Rose & Jasmine, the softening.",
            "body": "<p>Where most brands reach for water, we reach for petals. Rose calms and renews; jasmine replaces the filler in our formulas with a living floral base. The result is skincare that feels less like a product and more like a ritual you look forward to.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "eyebrow": "✦ The Living Greens",
            "heading": "Pegaga & Tremella, the restorers.",
            "body": "<p>Pegaga (centella) rebuilds the barrier; tremella mushroom holds water like silk. Ancestral botanicals, clinically understood — so your skin bounces back, day after day.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
