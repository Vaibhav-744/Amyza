{% comment %} about-banner.liquid — Cinematic quote banner {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .about-banner {
    padding: clamp(3rem, 6vw, 6rem) 0;
    background: {{ section.settings.outer_bg }};
    display: flex;
  }
  #shopify-section-{{ section.id }} .about-banner .pe-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 62vh;
    width: 100%;
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .about-banner-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    {%- if section.settings.image != blank -%}
      background-image: url({{ section.settings.image | image_url: width: 2000 }});
    {%- else -%}
      background: linear-gradient(135deg, {{ section.settings.bg_from }} 0%, {{ section.settings.bg_to }} 60%, #2A0A20 100%);
    {%- endif -%}
    transform: scale(1.06);
  }
  #shopify-section-{{ section.id }} .about-banner-overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
  }
  #shopify-section-{{ section.id }} .about-banner-content {
    position: relative;
    z-index: 2;
    max-width: 820px;
    padding: 3rem;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .about-banner-content p {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.5rem, 3.4vw, 2.6rem);
    line-height: 1.4;
    color: {{ section.settings.quote_color }};
  }

  @media (max-width: 980px) {
    #shopify-section-{{ section.id }} .about-banner {
      padding: 2.5rem 1.2rem;
    }
    #shopify-section-{{ section.id }} .about-banner .pe-media {
      min-height: 52vh;
    }
    #shopify-section-{{ section.id }} .about-banner-content {
      padding: 1.6rem;
    }
  }
</style>

<section class="about-banner" id="about-banner-{{ section.id }}">
  <div class="pe-media">
    <div class="about-banner-bg"></div>
    <div class="about-banner-overlay"></div>
    <div class="about-banner-content reveal-up">
      {%- if section.settings.quote != blank -%}
        <p>{{ section.settings.quote }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About — Quote Banner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "outer_bg",
      "label": "Outer Background",
      "default": "#F1EDEC",
      "info": "Default: --porcelain (#F1EDEC)"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card Border Radius (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image",
      "info": "If blank, a gradient is used."
    },
    {
      "type": "color",
      "id": "bg_from",
      "label": "Gradient From",
      "default": "#731157",
      "info": "Used when no image is set."
    },
    {
      "type": "color",
      "id": "bg_to",
      "label": "Gradient To",
      "default": "#4E0A3A",
      "info": "Used when no image is set."
    },
    {
      "type": "color_background",
      "id": "overlay_color",
      "label": "Overlay",
      "default": "linear-gradient(180deg, rgba(42,10,32,0.30) 0%, rgba(78,10,58,0.55) 60%, rgba(42,10,32,0.72) 100%)"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote Text",
      "default": "\"We don't sell skincare. We hand you a ritual your grandmother would recognise — and your future self will thank you for.\""
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote Color",
      "default": "#F1EDEC"
    }
  ],
  "presets": [
    {
      "name": "About — Quote Banner"
    }
  ]
}
{% endschema %}
