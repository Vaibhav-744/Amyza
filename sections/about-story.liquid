{% comment %} about-story.liquid — Origin Story section {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .about-story {
    padding: clamp(3rem, 10vw, 5rem) 6vw;
    background: {{ section.settings.section_bg }};
  }
  #shopify-section-{{ section.id }} .about-story-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  #shopify-section-{{ section.id }} .about-story-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    border-radius: 8px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .about-story-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .about-story-text .eyebrow {
    color: {{ section.settings.eyebrow_color }};
  }
  #shopify-section-{{ section.id }} .about-story-text h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.1;
    color: {{ section.settings.heading_color }};
    margin: .8rem 0 1.4rem;
  }
  #shopify-section-{{ section.id }} .about-story-text h2 em,
  #shopify-section-{{ section.id }} .about-story-text h2 .serif-italic {
    color: {{ section.settings.heading_italic_color }};
  }
  #shopify-section-{{ section.id }} .about-story-text p {
    font-size: 1.04rem;
    line-height: 1.8;
    color: {{ section.settings.body_color }};
    margin-bottom: 1.2rem;
  }
  #shopify-section-{{ section.id }} .about-story-text em {
    font-style: italic;
    color: {{ section.settings.em_color }};
  }
  #shopify-section-{{ section.id }} .about-story-text .btn {
    margin-top: 1rem;
    display: inline-block;
    padding: .95rem 1.8rem;
    border-radius: 4px;
    font-size: .7rem;
    letter-spacing: .24em;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    transition: .3s;
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text_color }};
    border: 1px solid {{ section.settings.btn_bg }};
  }
  #shopify-section-{{ section.id }} .about-story-text .btn:hover {
    background: {{ section.settings.btn_hover_bg }};
    border-color: {{ section.settings.btn_hover_bg }};
  }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .about-story-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    #shopify-section-{{ section.id }} .about-story-media {
      max-width: 480px;
      margin: 0 auto;
    }
  }
  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .about-story {
      padding: 3.5rem 1.2rem;
    }
  }
</style>

<section class="about-story" id="about-story-{{ section.id }}">
  <div class="about-story-grid">

    {%- if section.settings.image_position == 'left' -%}
      <div class="about-story-media reveal-left">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.image.alt | default: shop.name | escape }}"
            width="800"
            height="1000"
            loading="lazy"
          >
        {%- else -%}
          <img
            src="https://placehold.co/800x1000/731157/F1EDEC?text=Our+Story"
            alt="Our Story"
            width="800"
            height="1000"
          >
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="about-story-text reveal-up">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body_1 != blank -%}
        {{ section.settings.body_1 }}
      {%- endif -%}
      {%- if section.settings.body_2 != blank -%}
        {{ section.settings.body_2 }}
      {%- endif -%}
      {%- if section.settings.btn_text != blank -%}
        <a
          href="{{ section.settings.btn_url | default: '/collections/all' }}"
          class="btn"
        >{{ section.settings.btn_text }}</a>
      {%- endif -%}
    </div>

    {%- if section.settings.image_position == 'right' -%}
      <div class="about-story-media reveal-right">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.image.alt | default: shop.name | escape }}"
            width="800"
            height="1000"
            loading="lazy"
          >
        {%- else -%}
          <img
            src="https://placehold.co/800x1000/731157/F1EDEC?text=Our+Story"
            alt="Our Story"
            width="800"
            height="1000"
          >
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "About — Origin Story",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "default": "#F1EDEC",
      "info": "Default: --porcelain (#F1EDEC)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "✦ Where It Began"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#731157"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A name born from grace and eternal beauty."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2A0A20"
    },
    {
      "type": "color",
      "id": "heading_italic_color",
      "label": "Heading Italic Color",
      "default": "#731157"
    },
    {
      "type": "richtext",
      "id": "body_1",
      "label": "Paragraph 1",
      "default": "<p>AMYZA merges two Arabic names — MYZA, meaning grace, and AMARAH, eternal beauty. It began at a kitchen table, watching the women who raised us blend saffron, turmeric and rose into rituals passed down across generations.</p>"
    },
    {
      "type": "richtext",
      "id": "body_2",
      "label": "Paragraph 2",
      "default": "<p>Those recipes were never written down. They lived in hands, in scent, in the quiet confidence of women who knew their worth. We bottled that knowing — and gave it a modern soul.</p>"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#5c4350"
    },
    {
      "type": "color",
      "id": "em_color",
      "label": "Emphasis Color",
      "default": "#731157"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Shop the Ritual",
      "info": "Leave blank to hide."
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#731157"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#F1EDEC"
    },
    {
      "type": "color",
      "id": "btn_hover_bg",
      "label": "Button Hover Background",
      "default": "#4E0A3A"
    }
  ],
  "presets": [
    {
      "name": "About — Origin Story"
    }
  ]
}
{% endschema %}
