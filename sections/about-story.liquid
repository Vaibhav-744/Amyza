{% comment %} about-story.liquid — Origin Story section with full-width (heritage split) or containered layout {% endcomment %}

{%- liquid
  assign container = section.settings.container | default: 'fullwidth'
  if container == '1170'
    assign container_class = 'container-1170'
  elsif container == '1470'
    assign container_class = 'container-1470'
  elsif container == '1770'
    assign container_class = 'container-1770'
  elsif container == 'fullwidth'
    assign container_class = 'container-full'
  else
    assign container_class = 'container'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .about-story {
    background: {{ section.settings.section_bg }};
    {%- if container == 'fullwidth' -%}
      padding: 0;
    {%- else -%}
      padding: clamp(3rem, 8vw, 5.5rem) 0;
    {%- endif -%}
  }
  #shopify-section-{{ section.id }} .about-story > .container-full {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .about-story-grid {
    display: grid;
    {%- if container == 'fullwidth' -%}
      grid-template-columns: 1fr 1fr;
      gap: 0;
      align-items: stretch;
      max-width: 100%;
    {%- else -%}
      grid-template-columns: 1fr 1.1fr;
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: center;
      margin: 0 auto;
    {%- endif -%}
  }
  #shopify-section-{{ section.id }} .about-story-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    {%- if container == 'fullwidth' -%}
      border-radius: 0;
      aspect-ratio: 1 / 1;
      height: 100%;
    {%- else -%}
      aspect-ratio: 1 / 1;
      border-radius: 8px;
    {%- endif -%}
  }
  #shopify-section-{{ section.id }} .about-story-media img {
    {%- if container == 'fullwidth' -%}
      position: absolute;
      inset: 0;
    {%- endif -%}
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .about-story-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    {%- if container == 'fullwidth' -%}
      padding: clamp(3rem, 6vw, 6rem) 8%;
    {%- endif -%}
  }
  #shopify-section-{{ section.id }} .about-story-text .eyebrow {
    color: {{ section.settings.eyebrow_color }};
  }
  #shopify-section-{{ section.id }} .about-story-text h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.1;
    color: {{ section.settings.heading_color }};
    margin: .6rem 0 1.4rem;
    letter-spacing: var(--ls-title, -0.015em);
  }
  #shopify-section-{{ section.id }} .about-story-text h2 em,
  #shopify-section-{{ section.id }} .about-story-text h2 .serif-italic {
    color: {{ section.settings.heading_italic_color }};
  }
  #shopify-section-{{ section.id }} .about-story-text p {
    font-size: 1.04rem;
    line-height: 1.8;
    color: {{ section.settings.body_color }};
    margin-bottom: 1.2rem;
    letter-spacing: var(--ls-body, 0);
  }
  #shopify-section-{{ section.id }} .about-story-text em {
    font-style: italic;
    color: {{ section.settings.em_color }};
  }
  #shopify-section-{{ section.id }} .about-story-text .btn {
    margin-top: 1rem;
    display: inline-block;
    width: max-content;
    padding: .95rem 1.8rem;
    border-radius: 4px;
    font-size: .7rem;
    letter-spacing: var(--ls-button, 0.18em);
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    transition: .3s;
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text_color }};
    border: 1px solid {{ section.settings.btn_bg }};
  }
  #shopify-section-{{ section.id }} .about-story-text .btn:hover {
    background: {{ section.settings.btn_hover_bg }};
    border-color: {{ section.settings.btn_hover_bg }};
  }

  @media (max-width: 980px) {
    #shopify-section-{{ section.id }} .about-story-grid {
      grid-template-columns: 1fr;
      {%- if container == 'fullwidth' -%}
        gap: 0;
      {%- else -%}
        gap: 2.5rem;
      {%- endif -%}
    }
    #shopify-section-{{ section.id }} .about-story-text {
      {%- if container == 'fullwidth' -%}
        padding: 3rem 1.5rem;
      {%- endif -%}
    }
    #shopify-section-{{ section.id }} .about-story-media {
      {%- if container == 'fullwidth' -%}
        max-width: 100%;
        aspect-ratio: 1 / 1;
        height: auto;
      {%- else -%}
        max-width: 480px;
        margin: 0 auto;
      {%- endif -%}
    }
  }
  @media (max-width: 600px) {
    {%- if container != 'fullwidth' -%}
      #shopify-section-{{ section.id }} .about-story {
        padding: 3.5rem 0;
      }
    {%- endif -%}
  }
</style>

<section class="about-story" id="about-story-{{ section.id }}">
  <div class="{{ container_class }}">
    <div class="about-story-grid">

      {%- if section.settings.image_position == 'left' -%}
        <div class="about-story-media reveal-left">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              alt="{{ section.settings.image.alt | default: shop.name | escape }}"
              width="1200"
              height="1200"
              loading="lazy"
            >
          {%- else -%}
            <img
              src="https://placehold.co/800x800/731157/F1EDEC?text=Our+Story"
              alt="Our Story"
              width="800"
              height="800"
            >
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="about-story-text reveal-up">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body_1 != blank -%}
          {{ section.settings.body_1 }}
        {%- endif -%}
        {%- if section.settings.body_2 != blank -%}
          {{ section.settings.body_2 }}
        {%- endif -%}
        {%- if section.settings.btn_text != blank -%}
          <a
            href="{{ section.settings.btn_url | default: '/collections/all' }}"
            class="btn"
          >{{ section.settings.btn_text }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.image_position == 'right' -%}
        <div class="about-story-media reveal-right">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              alt="{{ section.settings.image.alt | default: shop.name | escape }}"
              width="1200"
              height="1200"
              loading="lazy"
            >
          {%- else -%}
            <img
              src="https://placehold.co/800x800/731157/F1EDEC?text=Our+Story"
              alt="Our Story"
              width="800"
              height="800"
            >
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "About — Origin Story",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:sections.layout.container.option",
      "default": "fullwidth",
      "options": [
        {
          "value": "container",
          "label": "t:sections.layout.container.option1"
        },
        {
          "value": "1170",
          "label": "t:sections.layout.container.option4"
        },
        {
          "value": "1470",
          "label": "t:sections.layout.container.option5"
        },
        {
          "value": "1770",
          "label": "t:sections.layout.container.option3"
        },
        {
          "value": "fullwidth",
          "label": "t:sections.layout.container.option2"
        }
      ]
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "default": "#F2EDEC",
      "info": "Default: --porcelain (#F2EDEC)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "✦ Where It Began"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#7D0A50"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A name born from grace and eternal beauty."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#9F9F46"
    },
    {
      "type": "color",
      "id": "heading_italic_color",
      "label": "Heading Italic Color",
      "default": "#7D0A50"
    },
    {
      "type": "richtext",
      "id": "body_1",
      "label": "Paragraph 1",
      "default": "<p>AMYZA merges two Arabic names — MYZA, meaning grace, and AMARAH, eternal beauty. It began at a kitchen table, watching the women who raised us blend saffron, turmeric and rose into rituals passed down across generations.</p>"
    },
    {
      "type": "richtext",
      "id": "body_2",
      "label": "Paragraph 2",
      "default": "<p>Those recipes were never written down. They lived in hands, in scent, in the quiet confidence of women who knew their worth. We bottled that knowing — and gave it a modern soul.</p>"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#5c4350"
    },
    {
      "type": "color",
      "id": "em_color",
      "label": "Emphasis Color",
      "default": "#7D0A50"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Shop the Ritual",
      "info": "Leave blank to hide."
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#7D0A50"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#F2EDEC"
    },
    {
      "type": "color",
      "id": "btn_hover_bg",
      "label": "Button Hover Background",
      "default": "#4E0A3A"
    }
  ],
  "presets": [
    {
      "name": "About — Origin Story"
    }
  ]
}
{% endschema %}
