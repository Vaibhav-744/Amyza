{% comment %} pdp-reviews.liquid — Product reviews grid + write-a-review form {% endcomment %}

<style>
  /* ── Section ── */
  #shopify-section-{{ section.id }} .pdp-reviews {
    padding: 4rem 6vw;
    text-align: center;
    background: {{ section.settings.section_bg }};
  }
  #shopify-section-{{ section.id }} .pdp-reviews h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3rem);
    color: {{ section.settings.heading_color }};
    margin-bottom: 2.4rem;
  }

  /* ── Summary ── */
  #shopify-section-{{ section.id }} .reviews-summary {
    margin: -1.4rem auto 2.6rem;
    color: #5a4350;
    font-size: .98rem;
    letter-spacing: .01em;
  }
  #shopify-section-{{ section.id }} .reviews-summary .rs-stars {
    color: var(--olive);
    letter-spacing: .12em;
    margin-right: .35rem;
  }
  #shopify-section-{{ section.id }} .reviews-summary strong {
    color: var(--plum);
  }

  /* ── Reviews grid ── */
  #shopify-section-{{ section.id }} .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
  }
  #shopify-section-{{ section.id }} .review-card {
    background: {{ section.settings.card_bg }};
    border: 1px solid {{ section.settings.card_border }};
    border-radius: 16px;
    padding: 1.8rem;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .review-card .stars {
    color: var(--olive);
    margin-bottom: .8rem;
  }
  #shopify-section-{{ section.id }} .review-card p {
    color: {{ section.settings.card_body_color }};
    line-height: 1.6;
    font-style: italic;
    margin-bottom: 1rem;
  }
  #shopify-section-{{ section.id }} .review-card .rv-name {
    font-size: .8rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: {{ section.settings.card_name_color }};
  }

  /* ── Write-a-review form ── */
  #shopify-section-{{ section.id }} .review-form-wrap {
    max-width: 640px;
    margin: 3.4rem auto 0;
    text-align: center;
    background: {{ section.settings.form_bg }};
    border: 1px solid rgba(115,17,87,.12);
    border-radius: 20px;
    padding: 2.6rem 2.4rem;
  }
  #shopify-section-{{ section.id }} .review-form-wrap h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: {{ section.settings.heading_color }};
    margin-bottom: .4rem;
    line-height: 1.1;
  }
  #shopify-section-{{ section.id }} .review-form-wrap .rf-sub {
    color: #6a5360;
    font-size: .92rem;
    margin-bottom: 1.8rem;
  }
  #shopify-section-{{ section.id }} .review-form {
    text-align: left;
  }
  #shopify-section-{{ section.id }} .review-form .rf-field {
    margin-bottom: 1.1rem;
  }
  #shopify-section-{{ section.id }} .review-form .rf-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  #shopify-section-{{ section.id }} .review-form label {
    display: block;
    font-size: .72rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--plum);
    margin-bottom: .5rem;
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .review-form label .opt {
    color: #9a8390;
    font-weight: 400;
    text-transform: none;
    letter-spacing: .02em;
  }
  #shopify-section-{{ section.id }} .review-form input,
  #shopify-section-{{ section.id }} .review-form textarea {
    width: 100%;
    font-family: var(--sans);
    font-size: .95rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid rgba(115,17,87,.18);
    border-radius: var(--radius-md);
    padding: .8rem .95rem;
    transition: border-color .25s, box-shadow .25s;
  }
  #shopify-section-{{ section.id }} .review-form textarea {
    min-height: 120px;
    resize: vertical;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .review-form input:focus,
  #shopify-section-{{ section.id }} .review-form textarea:focus {
    outline: none;
    border-color: var(--plum);
    box-shadow: 0 0 0 3px rgba(115,17,87,.12);
  }
  #shopify-section-{{ section.id }} .review-form input::placeholder,
  #shopify-section-{{ section.id }} .review-form textarea::placeholder {
    color: #b3a3ac;
  }
  #shopify-section-{{ section.id }} .review-form .btn {
    margin-top: .4rem;
  }

  /* ── Star input ── */
  #shopify-section-{{ section.id }} .star-input {
    display: inline-flex;
    gap: .25rem;
  }
  #shopify-section-{{ section.id }} .star-input .star {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 .08rem;
    font-size: 2rem;
    line-height: 1;
    color: #d9cbd3;
    transition: color .15s ease, transform .15s ease;
  }
  #shopify-section-{{ section.id }} .star-input .star:hover {
    transform: scale(1.12);
  }
  #shopify-section-{{ section.id }} .star-input .star.on {
    color: var(--olive);
  }
  #shopify-section-{{ section.id }} .star-input .star.sel {
    color: #c79a2f;
  }
  #shopify-section-{{ section.id }} .star-input .star:focus-visible {
    outline: 2px solid var(--plum);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* ── New card pop-in ── */
  #shopify-section-{{ section.id }} .review-card.rv-new {
    opacity: 0;
    transform: translateY(16px) scale(.98);
    transition: opacity .5s ease, transform .5s cubic-bezier(.22,.61,.36,1);
  }
  #shopify-section-{{ section.id }} .review-card.rv-new.in {
    opacity: 1;
    transform: none;
  }

  /* ── Status ── */
  #shopify-section-{{ section.id }} .rf-status {
    margin-top: 1rem;
    font-size: .88rem;
    min-height: 1.2em;
  }
  #shopify-section-{{ section.id }} .rf-status.ok {
    color: var(--emerald);
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .rf-status.err {
    color: #b3325a;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    #shopify-section-{{ section.id }} .reviews-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .reviews-grid {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .review-form .rf-row {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .review-form-wrap {
      padding: 2rem 1.4rem;
    }
  }
</style>

<section class="pdp-reviews" id="pdp-reviews-{{ section.id }}">

  {%- if section.settings.heading != blank -%}
    <h2 data-split>{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.settings.summary_rating != blank -%}
    <p class="reviews-summary">
      <span class="rs-stars">{{ section.settings.summary_rating }}</span>
      {%- if section.settings.summary_score != blank -%}
        <strong>{{ section.settings.summary_score }}</strong>
      {%- endif -%}
      {%- if section.settings.summary_count != blank -%}
        &nbsp;· {{ section.settings.summary_count }} reviews
      {%- endif -%}
    </p>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="reviews-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="review-card" {{ block.shopify_attributes }}>
            <div class="stars">
              {%- assign rating = block.settings.rating -%}
              {%- for i in (1..5) -%}
                {%- if i <= rating -%}★{%- else -%}☆{%- endif -%}
              {%- endfor -%}
            </div>
            {%- if block.settings.body != blank -%}
              <p>{{ block.settings.body }}</p>
            {%- endif -%}
            {%- if block.settings.name != blank -%}
              <span class="rv-name">
                — {{ block.settings.name }}{%- if block.settings.location != blank -%}, {{ block.settings.location }}{%- endif -%}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_form -%}
    <div class="review-form-wrap">
      <h3>{{ section.settings.form_heading }}</h3>
      <p class="rf-sub">{{ section.settings.form_subtext }}</p>

      <form class="review-form" id="rv-form-{{ section.id }}" novalidate>

        <div class="rf-field">
          <label>Your rating</label>
          <div class="star-input" role="radiogroup" aria-label="Star rating">
            {%- for i in (1..5) -%}
              <button type="button" class="star" data-val="{{ i }}" aria-label="{{ i }} star{%- if i != 1 -%}s{%- endif -%}">★</button>
            {%- endfor -%}
          </div>
          <input type="hidden" name="rating" id="rv-rating-val-{{ section.id }}" value="0">
        </div>

        <div class="rf-row">
          <div class="rf-field">
            <label for="rv-name-{{ section.id }}">Name</label>
            <input type="text" id="rv-name-{{ section.id }}" name="name" placeholder="Your name" autocomplete="name">
          </div>
          <div class="rf-field">
            <label for="rv-loc-{{ section.id }}">Location <span class="opt">(optional)</span></label>
            <input type="text" id="rv-loc-{{ section.id }}" name="location" placeholder="City" autocomplete="address-level2">
          </div>
        </div>

        <div class="rf-field">
          <label for="rv-body-{{ section.id }}">Your review</label>
          <textarea id="rv-body-{{ section.id }}" name="body" placeholder="Tell the AMYZA sisterhood about your glow…"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">{{ section.settings.form_btn_text }}</button>
        <p class="rf-status" id="rv-status-{{ section.id }}" aria-live="polite"></p>

      </form>
    </div>
  {%- endif -%}

</section>

<script>
  (function () {
    var form = document.getElementById('rv-form-{{ section.id }}');
    if (!form) return;

    var stars   = form.querySelectorAll('.star-input .star');
    var hidden  = form.querySelector('#rv-rating-val-{{ section.id }}');
    var status  = document.getElementById('rv-status-{{ section.id }}');
    var current = 0;

    function paint(n) {
      stars.forEach(function (s, i) {
        s.classList.toggle('on', i < n);
        s.classList.toggle('sel', i < current);
      });
    }

    stars.forEach(function (s, i) {
      s.addEventListener('mouseenter', function () { paint(i + 1); });
      s.addEventListener('mouseleave', function () { paint(current); });
      s.addEventListener('click', function () {
        current = i + 1;
        hidden.value = current;
        stars.forEach(function (st, j) {
          st.classList.toggle('sel', j < current);
          st.classList.remove('on');
        });
      });
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!current) {
        status.textContent = 'Please select a star rating.';
        status.className = 'rf-status err';
        setTimeout(function () { status.textContent = ''; status.className = 'rf-status'; }, 3000);
        return;
      }

      var name     = (form.querySelector('[name="name"]').value || '').trim();
      var location = (form.querySelector('[name="location"]').value || '').trim();
      var body     = (form.querySelector('[name="body"]').value || '').trim();

      if (!name || !body) {
        status.textContent = 'Please add your name and review.';
        status.className = 'rf-status err';
        setTimeout(function () { status.textContent = ''; status.className = 'rf-status'; }, 3000);
        return;
      }

      /* ── Build stars string ── */
      var starStr = '';
      for (var n = 1; n <= 5; n++) {
        starStr += n <= current ? '★' : '☆';
      }

      /* ── Create and append new card ── */
      var grid = document.querySelector('#pdp-reviews-{{ section.id }} .reviews-grid');
      if (grid) {
        var card = document.createElement('div');
        card.className = 'review-card rv-new';
        card.innerHTML =
          '<div class="stars">' + starStr + '</div>' +
          '<p>' + escHtml(body) + '</p>' +
          '<span class="rv-name">— ' + escHtml(name) + (location ? ', ' + escHtml(location) : '') + '</span>';
        grid.insertBefore(card, grid.firstChild);
        /* trigger pop-in */
        requestAnimationFrame(function () {
          requestAnimationFrame(function () { card.classList.add('in'); });
        });
      }

      /* ── Feedback & reset ── */
      status.textContent = '✦ Thank you — your review is live.';
      status.className = 'rf-status ok';
      form.reset();
      current = 0;
      paint(0);
      setTimeout(function () { status.textContent = ''; status.className = 'rf-status'; }, 3000);
    });

    function escHtml(str) {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
  })();
</script>

