{% comment %} pdp-key-features.liquid — Key Product Benefits & Features Showcase (Metafield & Dynamic Source Ready) {% endcomment %}

{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.section_bg | default: '#f7f4f3'
  assign heading = section.settings.heading
  assign heading_color = section.settings.heading_color | default: '#731157'
  assign subheading = section.settings.subheading
  assign subheading_color = section.settings.subheading_color | default: '#731157'

  assign title_color = section.settings.title_color | default: '#2a0a20'
  assign body_color = section.settings.body_color | default: '#5a4350'
  
  assign show_image = section.settings.center_image | default: product.featured_image
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
  }

  .pdp-kf-section {
    padding: {{ section.settings.padding_top }}px 1.5rem {{ section.settings.padding_bottom }}px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .pdp-kf-header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 3.5rem auto;
  }

  .pdp-kf-subheading {
    font-family: var(--sans, 'Public Sans', sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: {{ subheading_color }};
    margin-bottom: 0.6rem;
  }

  .pdp-kf-heading {
    font-family: var(--serif, 'Instrument Serif', serif);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 400;
    color: {{ heading_color }};
    line-height: 1.15;
    margin: 0;
  }

  /* Grid Layout: 3 Columns (Left Features | Center Scalloped Image | Right Features) */
  .pdp-kf-grid {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 360px) 1fr;
    gap: 3.5rem 2.5rem;
    align-items: center;
  }

  .pdp-kf-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
  }

  /* Feature Block Styling */
  .pdp-kf-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .pdp-kf-col-left .pdp-kf-block {
    text-align: right;
  }

  .pdp-kf-col-right .pdp-kf-block {
    text-align: left;
  }

  .pdp-kf-block-tag {
    font-family: var(--sans, 'Public Sans', sans-serif);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--plum, #731157);
    margin-bottom: 0.1rem;
  }

  .pdp-kf-block-title {
    font-family: var(--sans, 'Public Sans', sans-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: {{ title_color }};
    line-height: 1.3;
    margin: 0;
  }

  .pdp-kf-block-desc {
    font-family: var(--sans, 'Public Sans', sans-serif);
    font-size: 0.9rem;
    font-weight: 400;
    color: {{ body_color }};
    line-height: 1.6;
    margin: 0;
  }

  /* Center Scalloped Badge Showcase */
  .pdp-kf-center {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 1rem;
  }

  .pdp-kf-badge-wrapper {
    position: relative;
    width: 100%;
    max-width: 350px;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Scalloped Backdrop Flower Ring */
  .pdp-kf-badge-backdrop {
    position: absolute;
    inset: -10px;
    background: {{ section.settings.image_bg_color | default: '#f1edec' }};
    border-radius: 50%;
    box-shadow: 0 15px 45px rgba(115, 17, 87, 0.08);
  }

  /* Scalloped Wavy Frame Image Container */
  .pdp-kf-image-frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 46% 54% 50% 50% / 50% 46% 54% 50%;
    overflow: hidden;
    z-index: 2;
    box-shadow: 0 12px 35px rgba(42, 10, 32, 0.12);
    transition: transform 0.5s ease, border-radius 0.5s ease;
    background: #ffffff;
  }

  .pdp-kf-image-frame:hover {
    transform: scale(1.02);
    border-radius: 50% 50% 46% 54% / 54% 46% 50% 50%;
  }

  .pdp-kf-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Responsive Styling */
  @media (max-width: 989px) {
    .pdp-kf-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .pdp-kf-center {
      order: 1;
      max-width: 300px;
      margin: 0 auto;
    }

    .pdp-kf-col-left {
      order: 2;
    }

    .pdp-kf-col-right {
      order: 3;
    }

    .pdp-kf-col-left .pdp-kf-block,
    .pdp-kf-col-right .pdp-kf-block {
      text-align: center;
    }

    .pdp-kf-header {
      margin-bottom: 2rem;
    }

    .pdp-kf-block-title {
      font-size: 1.12rem;
    }

    .pdp-kf-block-desc {
      font-size: 0.88rem;
    }
  }
</style>

<div class="pdp-kf-section">
  {%- if heading != blank or subheading != blank -%}
    <div class="pdp-kf-header">
      {%- if subheading != blank -%}
        <div class="pdp-kf-subheading">{{ subheading }}</div>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="pdp-kf-heading">{{ heading }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- liquid
    assign total_blocks = section.blocks.size
    if total_blocks == 4
      assign left_count = 2
    elsif total_blocks == 3
      assign left_count = 2
    else
      assign left_count = 1
    endif
  -%}

  <div class="pdp-kf-grid">
    {%- comment -%} LEFT FEATURES COLUMN {%- endcomment -%}
    <div class="pdp-kf-col pdp-kf-col-left">
      {%- for block in section.blocks limit: left_count -%}
        {%- liquid
          assign tag_val = block.settings.tag
          assign title_val = block.settings.title
          assign desc_val = block.settings.description

          if block.settings.metafield_key != blank
            assign mf_key = block.settings.metafield_key | strip
            if product.metafields.custom[mf_key] != blank
              assign desc_val = product.metafields.custom[mf_key] | metafield_tag
            elsif product.metafields[mf_key] != blank
              assign desc_val = product.metafields[mf_key]
            endif
          endif
        -%}
        {%- if tag_val != blank or title_val != blank or desc_val != blank -%}
          <div class="pdp-kf-block" {{ block.shopify_attributes }}>
            {%- if tag_val != blank -%}
              <span class="pdp-kf-block-tag">{{ tag_val }}</span>
            {%- endif -%}
            {%- if title_val != blank -%}
              <h3 class="pdp-kf-block-title">{{ title_val }}</h3>
            {%- endif -%}
            {%- if desc_val != blank -%}
              <div class="pdp-kf-block-desc">{{ desc_val }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} CENTER SCALLOPED IMAGE SHOWCASE {%- endcomment -%}
    <div class="pdp-kf-center">
      <div class="pdp-kf-badge-wrapper">
        <div class="pdp-kf-badge-backdrop"></div>
        <div class="pdp-kf-image-frame">
          {%- if section.settings.center_image != blank -%}
            <img
              src="{{ section.settings.center_image | image_url: width: 800 }}"
              alt="{{ heading | escape }}"
              loading="lazy"
              width="400"
              height="400"
            >
          {%- elsif product.featured_image != blank -%}
            <img
              src="{{ product.featured_image | image_url: width: 800 }}"
              alt="{{ product.title | escape }}"
              loading="lazy"
              width="400"
              height="400"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} RIGHT FEATURES COLUMN {%- endcomment -%}
    <div class="pdp-kf-col pdp-kf-col-right">
      {%- for block in section.blocks offset: left_count -%}
        {%- liquid
          assign tag_val = block.settings.tag
          assign title_val = block.settings.title
          assign desc_val = block.settings.description

          if block.settings.metafield_key != blank
            assign mf_key = block.settings.metafield_key | strip
            if product.metafields.custom[mf_key] != blank
              assign desc_val = product.metafields.custom[mf_key] | metafield_tag
            elsif product.metafields[mf_key] != blank
              assign desc_val = product.metafields[mf_key]
            endif
          endif
        -%}
        {%- if tag_val != blank or title_val != blank or desc_val != blank -%}
          <div class="pdp-kf-block" {{ block.shopify_attributes }}>
            {%- if tag_val != blank -%}
              <span class="pdp-kf-block-tag">{{ tag_val }}</span>
            {%- endif -%}
            {%- if title_val != blank -%}
              <h3 class="pdp-kf-block-title">{{ title_val }}</h3>
            {%- endif -%}
            {%- if desc_val != blank -%}
              <div class="pdp-kf-block-desc">{{ desc_val }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PDP — Key Features",
  "tag": "section",
  "class": "shopify-section-pdp-key-features",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background Color",
      "default": "#f7f4f3"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading / Tagline (Supports Metafields)",
      "default": "✦ RITUAL BENEFITS"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#731157"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Section Heading (Supports Metafields)",
      "default": "Why You'll Love AMYZA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#731157"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center Showcase Image (Supports Metafields)"
    },
    {
      "type": "color",
      "id": "image_bg_color",
      "label": "Scalloped Frame Tint",
      "default": "#f1edec"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Feature Title Color",
      "default": "#2a0a20"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Feature Description Color",
      "default": "#5a4350"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Key Feature",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "tag",
          "label": "Feature Tag / Category (Supports Metafields)",
          "default": "✦ RENEW"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Feature Title (Supports Metafields)",
          "default": "Stimulates Cell Renewal"
        },
        {
          "type": "inline_richtext",
          "id": "description",
          "label": "Feature Description (Supports Metafields)",
          "default": "Ancestral botanicals support the skin's natural renewal process while replenishing moisture, leaving skin refreshed, resilient, and revitalised."
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "Custom Metafield Key Fallback (Optional)",
          "info": "e.g. product_usp or feature_1. If filled, content will be dynamically fetched from product.metafields.custom[key]"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP — Key Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "tag": "✦ RENEW",
            "title": "Stimulates Cell Renewal",
            "description": "Ancestral botanicals support the skin's natural renewal process while replenishing moisture, leaving skin refreshed, resilient, and revitalised."
          }
        },
        {
          "type": "feature",
          "settings": {
            "tag": "✦ HYDRATE",
            "title": "Deep Moisture Lock",
            "description": "Tremella mushroom holds moisture like silk, deeply hydrating skin layers without any heavy or greasy residue."
          }
        },
        {
          "type": "feature",
          "settings": {
            "tag": "✦ AGELESS",
            "title": "Slows Visible Signs of Ageing",
            "description": "Saffron and collagen-rich botanical complex improves elasticity and softens fine lines, coaxes a lit-from-within glow."
          }
        },
        {
          "type": "feature",
          "settings": {
            "tag": "✦ GLOW",
            "title": "Promotes a Radiant Complexion",
            "description": "Rose & Jasmine floral waters energise and revitalise the skin while defending against daily environmental stressors."
          }
        }
      ]
    }
  ]
}
{% endschema %}
