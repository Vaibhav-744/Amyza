<style>
  #shopify-section-{{ section.id }} .announcement{
    position: relative;
    z-index: 1;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top_desktop }}px 0 {{ section.settings.padding_bottom_desktop }}px;
    overflow: hidden;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .announcement {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }
  }

  #shopify-section-{{ section.id }} .marquee-track{
    display: flex;
    width: max-content;
    will-change: transform;
    animation: marquee-{{ section.id }} {{ section.settings.animation_speed }}s linear infinite;
  }

  #shopify-section-{{ section.id }} .marquee-track:hover{
    {% if section.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .marquee-group{
    font-size: clamp({{ section.settings.font_size_min }}rem, 4vw, {{ section.settings.font_size_max }}rem);
    font-style:italic;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    white-space: nowrap;
    opacity:0.85;
  }

  #shopify-section-{{ section.id }} .marquee-group div{
    padding: 0 1rem;
    white-space: nowrap;
    color: {{ section.settings.text_color }};
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .marquee-group div em{
        color: var(--blush);
        font-family: var(--serif);
  }

  @keyframes marquee-{{ section.id }}{
    0%{
      transform: translateX(0);
    }
    100%{
      transform: translateX(-20%);
    }
  }

  @media(max-width:767px){
    #shopify-section-{{ section.id }} .marquee-group div{
      padding: 0 1rem;
    }
  }</style>

<div class="announcement">
  <div class="marquee-track">

    {% for i in (1..5) %}
      <div class="marquee-group" {% if i != 1 %}aria-hidden="true"{% endif %}>
        {% for block in section.blocks %}
          <div {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {% endfor %}
      </div>
    {% endfor %}

  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "class": "section-announcement-bar",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#731157"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F1EDEC"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop — Padding Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop — Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile — Padding Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile — Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size_min",
      "label": "Font Size — Mobile",
      "min": 0.5,
      "max": 3,
      "step": 0.1,
      "unit": "rem",
      "default": 1.6
    },
    {
      "type": "range",
      "id": "font_size_max",
      "label": "Font Size — Desktop",
      "min": 1,
      "max": 6,
      "step": 0.1,
      "unit": "rem",
      "default": 3.0
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Animation Speed",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "s",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause Animation on Hover",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Item",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>✦ Free shipping on orders over RM150</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}