{% comment %} about-philosophy.liquid — Ingredients with a lineage {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .about-philosophy {
    padding: clamp(5rem, 10vw, 9rem) 6vw;
    background: {{ section.settings.section_bg }};
  }
  #shopify-section-{{ section.id }} .about-philo-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  #shopify-section-{{ section.id }} .about-philo-text .eyebrow {
    color: {{ section.settings.eyebrow_color }};
  }
  #shopify-section-{{ section.id }} .about-philo-text h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.2rem);
    color: {{ section.settings.heading_color }};
    margin: .8rem 0 1.4rem;
    line-height: 1.1;
  }
  #shopify-section-{{ section.id }} .about-philo-text h2 em,
  #shopify-section-{{ section.id }} .about-philo-text h2 .serif-italic {
    color: {{ section.settings.heading_italic_color }};
  }
  #shopify-section-{{ section.id }} .about-philo-text > p {
    font-size: 1.04rem;
    line-height: 1.8;
    color: {{ section.settings.body_color }};
    margin-bottom: 1.8rem;
  }
  #shopify-section-{{ section.id }} .philo-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  #shopify-section-{{ section.id }} .philo-list li {
    display: flex;
    flex-direction: column;
    gap: .15rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }
  #shopify-section-{{ section.id }} .philo-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  #shopify-section-{{ section.id }} .philo-list strong {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
    color: {{ section.settings.item_title_color }};
  }
  #shopify-section-{{ section.id }} .philo-list span {
    font-size: .92rem;
    color: {{ section.settings.item_desc_color }};
  }
  #shopify-section-{{ section.id }} .about-philo-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    border-radius: 8px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .about-philo-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .about-philo-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    #shopify-section-{{ section.id }} .about-philo-media {
      order: -1;
      max-width: 480px;
      margin: 0 auto;
    }
    #shopify-section-{{ section.id }} .about-philosophy {
      padding: 3.5rem 1.2rem;
    }
  }
</style>

<section class="about-philosophy" id="about-philosophy-{{ section.id }}">
  <div class="about-philo-grid">

    <div class="about-philo-text reveal-left">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p>{{ section.settings.intro }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="philo-list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <strong>{{ block.settings.title }}</strong>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <span>{{ block.settings.description }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="about-philo-media reveal-right">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image.alt | default: 'Philosophy' | escape }}"
          width="800"
          height="1000"
          loading="lazy"
        >
      {%- else -%}
        <img
          src="https://placehold.co/800x1000/4E0A3A/F1EDEC?text=Philosophy"
          alt="Philosophy"
          width="800"
          height="1000"
        >
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "About — Philosophy",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "default": "#4E0A3A",
      "info": "Default: --plum-deep (#4E0A3A)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "✦ Our Philosophy"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#EAACC9",
      "info": "Default: --blush (#EAACC9)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ingredients with a lineage, not a label."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#F1EDEC"
    },
    {
      "type": "color",
      "id": "heading_italic_color",
      "label": "Heading Italic Color",
      "default": "#EAACC9"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro Paragraph",
      "default": "We don't chase trends. We honour botanicals that have soothed, healed and brightened skin for centuries — saffron from the highlands, pegaga from Malaysian soil, rose and jasmine from the gardens of memory."
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Color",
      "default": "#e9d4e2"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "List Divider Color",
      "default": "rgba(234,172,201,0.22)"
    },
    {
      "type": "color",
      "id": "item_title_color",
      "label": "Ingredient Name Color",
      "default": "#EAACC9"
    },
    {
      "type": "color",
      "id": "item_desc_color",
      "label": "Ingredient Description Color",
      "default": "#d8bccf"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Saffron"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "The golden thread of radiance."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Philosophy",
      "blocks": [
        {
          "type": "ingredient",
          "settings": { "title": "Saffron", "description": "The golden thread of radiance." }
        },
        {
          "type": "ingredient",
          "settings": { "title": "Pegaga", "description": "Malaysia's local healing hero." }
        },
        {
          "type": "ingredient",
          "settings": { "title": "Rose & Jasmine", "description": "Softness, distilled into ritual." }
        },
        {
          "type": "ingredient",
          "settings": { "title": "Turmeric", "description": "The ancestral glow-giver." }
        }
      ]
    }
  ]
}
{% endschema %}
