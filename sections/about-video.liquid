{% comment %} about-video.liquid — Cinematic autoplay video with text overlay {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .av-section {
    position: relative;
    overflow: hidden;
    padding: clamp(9rem, 16vw, 14rem) 6vw clamp(5rem, 9vw, 8rem);
    text-align: center;
    background: {{ section.settings.fallback_bg }};
  }

  /* ── Video ── */
  #shopify-section-{{ section.id }} .av-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    z-index: 0;
  }

  /* ── Overlay ── */
  #shopify-section-{{ section.id }} .av-overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay }};
    z-index: 1;
    pointer-events: none;
  }

  /* ── Content — always on top ── */
  #shopify-section-{{ section.id }} .av-inner {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .av-eyebrow {
    display: block;
    font-size: .78rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin-bottom: 1.1rem;
  }
  #shopify-section-{{ section.id }} .av-heading {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.6rem, 6.5vw, 5.4rem);
    line-height: 1.04;
    color: {{ section.settings.heading_color }};
    margin: 0 auto 1.4rem;
    max-width: 20ch;
  }
  #shopify-section-{{ section.id }} .av-sub {
    font-size: clamp(1.02rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: {{ section.settings.sub_color }};
    max-width: 60ch;
    margin: 0 auto 2rem;
  }
  #shopify-section-{{ section.id }} .av-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: .9rem;
    font-size: .8rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: {{ section.settings.tags_color }};
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .av-section { padding-top: 7rem; }
    #shopify-section-{{ section.id }} .av-meta { font-size: .72rem; }
  }
</style>

<section class="av-section" id="about-video-{{ section.id }}">

  {%- if section.settings.video != blank -%}
    <video
      class="av-video"
      src="{{ section.settings.video.sources[1].url | default: section.settings.video.sources[0].url }}"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>
  {%- endif -%}

  <div class="av-overlay"></div>

  <div class="av-inner">

    {%- if section.settings.eyebrow != blank -%}
      <span class="av-eyebrow" data-rise>{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="av-heading" data-split>{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="av-sub" data-rise>{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- assign tag1 = section.settings.tag_1 -%}
    {%- assign tag2 = section.settings.tag_2 -%}
    {%- assign tag3 = section.settings.tag_3 -%}
    {%- if tag1 != blank or tag2 != blank or tag3 != blank -%}
      <div class="av-meta" data-stagger>
        {%- if tag1 != blank -%}<span data-rise>{{ tag1 }}</span>{%- endif -%}
        {%- if tag1 != blank and tag2 != blank -%}<span data-rise>·</span>{%- endif -%}
        {%- if tag2 != blank -%}<span data-rise>{{ tag2 }}</span>{%- endif -%}
        {%- if tag2 != blank and tag3 != blank -%}<span data-rise>·</span>{%- endif -%}
        {%- if tag3 != blank -%}<span data-rise>{{ tag3 }}</span>{%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "About — Video Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Upload an .mp4 directly from the theme editor. Plays muted, looped, without controls."
    },
    {
      "type": "color",
      "id": "fallback_bg",
      "label": "Fallback Background",
      "default": "#2A0A20",
      "info": "Shown while the video loads or when no video is set."
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color_background",
      "id": "overlay",
      "label": "Overlay",
      "default": "linear-gradient(180deg, rgba(42,10,32,0.38) 0%, rgba(42,10,32,0.62) 100%)"
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "✦ Our Story"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Colour",
      "default": "#EAACC9"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beauty, the way our grandmothers knew it."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Colour",
      "default": "#F1EDEC"
    },
    {
      "type": "header",
      "content": "Subtext"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "AMYZA is a love letter to ancestral botanical wisdom — bottled with bold, modern femininity for the woman who refuses to choose between heritage and now."
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Subtext Colour",
      "default": "rgba(241,237,236,0.85)"
    },
    {
      "type": "header",
      "content": "Tag Strip"
    },
    {
      "type": "text",
      "id": "tag_1",
      "label": "Tag 1",
      "default": "South Asian roots"
    },
    {
      "type": "text",
      "id": "tag_2",
      "label": "Tag 2",
      "default": "Crafted in Malaysia"
    },
    {
      "type": "text",
      "id": "tag_3",
      "label": "Tag 3",
      "default": "Slow luxury"
    },
    {
      "type": "color",
      "id": "tags_color",
      "label": "Tags Colour",
      "default": "#F1EDEC"
    }
  ],
  "presets": [
    {
      "name": "About — Video Hero"
    }
  ]
}
{% endschema %}
