{% comment %} about-cta.liquid — Final call-to-action section {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .about-cta {
    padding: clamp(5rem, 11vw, 10rem) 6vw;
    text-align: center;
    background: {{ section.settings.section_bg }};
  }
  #shopify-section-{{ section.id }} .about-cta-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .about-cta-inner h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.4rem, 5.5vw, 4.4rem);
    color: {{ section.settings.heading_color }};
    margin-bottom: 1rem;
    line-height: 1.05;
  }
  #shopify-section-{{ section.id }} .about-cta-inner h2 em,
  #shopify-section-{{ section.id }} .about-cta-inner h2 .serif-italic {
    color: {{ section.settings.heading_italic_color }};
  }
  #shopify-section-{{ section.id }} .about-cta-inner > p {
    font-size: 1.1rem;
    color: {{ section.settings.body_color }};
    margin-bottom: 2rem;
  }
  #shopify-section-{{ section.id }} .about-cta-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .about-cta-btns .btn {
    display: inline-block;
    padding: .95rem 1.8rem;
    border-radius: 4px;
    font-size: .7rem;
    letter-spacing: .24em;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    transition: .3s;
  }
  #shopify-section-{{ section.id }} .about-cta-btns .btn-primary {
    background: {{ section.settings.btn1_bg }};
    color: {{ section.settings.btn1_text_color }};
    border: 1px solid {{ section.settings.btn1_bg }};
  }
  #shopify-section-{{ section.id }} .about-cta-btns .btn-primary:hover {
    background: {{ section.settings.btn1_hover_bg }};
    border-color: {{ section.settings.btn1_hover_bg }};
  }
  #shopify-section-{{ section.id }} .about-cta-btns .btn-secondary {
    background: transparent;
    color: {{ section.settings.btn2_color }};
    border: 1px solid {{ section.settings.btn2_color }};
  }
  #shopify-section-{{ section.id }} .about-cta-btns .btn-secondary:hover {
    background: {{ section.settings.btn2_color }};
    color: #F1EDEC;
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .about-cta {
      padding: 3.5rem 1.2rem;
    }
    #shopify-section-{{ section.id }} .about-cta-btns {
      flex-direction: column;
      align-items: center;
    }
  }
</style>

<section class="about-cta" id="about-cta-{{ section.id }}">
  <div class="about-cta-inner reveal-up">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p>{{ section.settings.body }}</p>
    {%- endif -%}
    <div class="about-cta-btns">
      {%- if section.settings.btn1_text != blank -%}
        <a
          href="{{ section.settings.btn1_url | default: '/collections/all' }}"
          class="btn btn-primary"
        >{{ section.settings.btn1_text }}</a>
      {%- endif -%}
      {%- if section.settings.btn2_text != blank -%}
        <a
          href="{{ section.settings.btn2_url | default: '/collections/all' }}"
          class="btn btn-secondary"
        >{{ section.settings.btn2_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About — CTA",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_background",
      "id": "section_bg",
      "label": "Background",
      "default": "linear-gradient(180deg, #efe3ea 0%, #F1EDEC 60%)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Begin your ritual."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2A0A20"
    },
    {
      "type": "color",
      "id": "heading_italic_color",
      "label": "Heading Italic Color",
      "default": "#731157"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body Text",
      "default": "Join thousands of women rediscovering the glow that was always theirs."
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#5c4350"
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "Shop Golden Nectar",
      "info": "Leave blank to hide."
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 URL"
    },
    {
      "type": "color",
      "id": "btn1_bg",
      "label": "Button 1 Background",
      "default": "#731157"
    },
    {
      "type": "color",
      "id": "btn1_text_color",
      "label": "Button 1 Text Color",
      "default": "#F1EDEC"
    },
    {
      "type": "color",
      "id": "btn1_hover_bg",
      "label": "Button 1 Hover Background",
      "default": "#4E0A3A"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "Explore the Collection →",
      "info": "Leave blank to hide."
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 URL"
    },
    {
      "type": "color",
      "id": "btn2_color",
      "label": "Button 2 Color",
      "default": "#731157"
    }
  ],
  "presets": [
    {
      "name": "About — CTA"
    }
  ]
}
{% endschema %}
