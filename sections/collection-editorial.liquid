{% comment %} collection-editorial-banner.liquid {% endcomment %}

<style>
  /* ── Outer wrapper — full bleed, no horizontal padding ── */
  #shopify-section-{{ section.id }} .ceb-wrap {
    background: {{ section.settings.section_bg }};
  }

  /* ── Two-panel grid ── */
  #shopify-section-{{ section.id }} .ceb-grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 2 }}, 1fr);
    gap: 0;
  }

  /* ── Single panel ── */
  #shopify-section-{{ section.id }} .ceb-panel {
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  /* ── Image frame — same intrinsic ratio for every panel ── */
  #shopify-section-{{ section.id }} .ceb-img-frame {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    display: block;
  }

  #shopify-section-{{ section.id }} .ceb-img-frame img,
  #shopify-section-{{ section.id }} .ceb-img-frame .ceb-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .8s cubic-bezier(.16, 1, .3, 1);
  }

  #shopify-section-{{ section.id }} .ceb-panel:hover .ceb-img-frame img {
    transform: scale(1.04);
  }

  /* ── Fallback gradient ── */
  #shopify-section-{{ section.id }} .ceb-fallback {
    background: linear-gradient(135deg, var(--plum) 0%, var(--plum-deep) 55%, #8C4C70 100%);
  }

  /* ── Text block beneath each image ── */
  #shopify-section-{{ section.id }} .ceb-body {
    padding: {{ section.settings.text_padding_desktop }}px {{ section.settings.text_padding_desktop | times: 0.75 }}px;
    background: {{ section.settings.section_bg }};
    flex: 1;
  }

  #shopify-section-{{ section.id }} .ceb-eyebrow {
    font-size: .68rem;
    letter-spacing: .25em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    font-weight: 500;
    margin-bottom: .6rem;
    display: block;
  }

  #shopify-section-{{ section.id }} .ceb-title {
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: {{ section.settings.title_color }};
    font-weight: 500;
    margin: 0 0 .7rem;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .ceb-desc {
    font-size: clamp(.88rem, 1.1vw, .98rem);
    line-height: 1.65;
    color: {{ section.settings.desc_color }};
    margin: 0 0 1.2rem;
    max-width: 52ch;
  }

  /* ── "Shop Now" link — mirrors .link-arrow from heritage ── */
  #shopify-section-{{ section.id }} .ceb-link {
    display: inline-block;
    font-size: .72rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    font-weight: 600;
    color: {{ section.settings.link_color }};
    border-bottom: 1px solid {{ section.settings.link_color }};
    padding-bottom: .25rem;
    transition: letter-spacing .3s, color .3s, border-color .3s;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .ceb-link:hover {
    color: {{ section.settings.link_hover_color }};
    border-color: {{ section.settings.link_hover_color }};
  }

  /* ── Mobile — stack vertically ── */
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .ceb-grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .ceb-body {
      padding: 1.4rem 1.2rem 1.8rem;
    }
  }
</style>

<div class="ceb-wrap">
  <div class="ceb-grid">
    {% for block in section.blocks %}
      <article class="ceb-panel" {{ block.shopify_attributes }}>

        {%- assign link_url = block.settings.link | default: '#' -%}

        <a href="{{ link_url }}" class="ceb-img-frame" aria-label="{{ block.settings.title | escape }}">
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              srcset="
                {{ block.settings.image | image_url: width: 600 }} 600w,
                {{ block.settings.image | image_url: width: 900 }} 900w,
                {{ block.settings.image | image_url: width: 1200 }} 1200w
              "
              sizes="(max-width: 767px) 100vw, 50vw"
              alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            />
          {% else %}
            <div class="ceb-fallback" style="background: {{ block.settings.fallback_bg }};"></div>
          {% endif %}
        </a>
      {% if block.settings.eyebrow != blank or block.settings.title != blank or block.settings.description != blank or block.settings.link_label != blank %}
        <div class="ceb-body">
          {% if block.settings.eyebrow != blank %}
            <span class="ceb-eyebrow">{{ block.settings.eyebrow }}</span>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="ceb-title">{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="ceb-desc">{{ block.settings.description }}</p>
          {% endif %}

          {% if block.settings.link_label != blank %}
            <a href="{{ link_url }}" class="ceb-link">{{ block.settings.link_label }}</a>
          {% endif %}
        </div>
      {% endif %}
      </article>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collection Editorial",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "3 / 2",   "label": "3:2  Landscape" },
        { "value": "4 / 3",   "label": "4:3  Standard"  },
        { "value": "1 / 1",   "label": "1:1  Square"    },
        { "value": "4 / 5",   "label": "4:5  Portrait"  },
        { "value": "16 / 9",  "label": "16:9 Wide"      }
      ],
      "default": "3 / 2"
    },
    {
      "type": "range",
      "id": "text_padding_desktop",
      "label": "Text Padding — Desktop (rem)",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#F7F4F3"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "default": "#e8e0e4"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#731157"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#2A0A20"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Color",
      "default": "#5a3545"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#2A0A20"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link Hover Color",
      "default": "#731157"
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback_bg",
          "label": "Fallback Background",
          "default": "linear-gradient(135deg, #731157 0%, #4e0a3a 100%)",
          "info": "Shown when no image is uploaded. CSS gradient or hex color."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow (optional)",
          "info": "Small label above the title, e.g. 'New Arrival'"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "A Holiday Toast"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Warm, sweet and delectable — a refined vision of comfort that takes you from house parties to the workout studio with ease."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Editorial",
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "eyebrow": "New Collection",
            "title": "The Ritual Edit",
            "description": "Slow-luxury skincare rooted in ancestral botanical wisdom — crafted in small batches, made for the woman who knows her worth.",
            "link_label": "Shop Now",
            "fallback_bg": "linear-gradient(135deg, #731157 0%, #4e0a3a 100%)"
          }
        },
        {
          "type": "panel",
          "settings": {
            "eyebrow": "Bestseller",
            "title": "Golden Nectar Serum",
            "description": "Saffron, Jasmine, Rose, Sandalwood & Turmeric — traditional recipes treasured for centuries, bottled into a ritual that works.",
            "link_label": "Shop Now",
            "fallback_bg": "linear-gradient(135deg, #EAACC9 0%, #731157 100%)"
          }
        }
      ]
    }
  ]
}
{% endschema %}
