{% comment %} bot-catalogue.liquid — Full botanical apothecary grid {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .bot-catalogue {
    padding: clamp(3rem, 7vw, 6rem) 6vw;
    background: {{ section.settings.section_bg }};
  }

  /* ── Section header ── */
  #shopify-section-{{ section.id }} .bot-catalogue .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(2rem, 4vw, 3.2rem);
  }
  #shopify-section-{{ section.id }} .bot-catalogue .eyebrow {
    color: {{ section.settings.eyebrow_color }};
  }
  #shopify-section-{{ section.id }} .bot-catalogue .section-header h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    color: {{ section.settings.heading_color }};
    margin: .6rem 0 .8rem;
    line-height: 1.1;
  }
  #shopify-section-{{ section.id }} .bot-catalogue .section-header h2 em {
    color: {{ section.settings.heading_italic_color }};
  }
  #shopify-section-{{ section.id }} .bot-catalogue .section-sub {
    color: {{ section.settings.sub_color }};
    font-size: 1rem;
    line-height: 1.6;
  }

  /* ── Grid ── */
  #shopify-section-{{ section.id }} .bot-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.4rem;
    max-width: 1300px;
    margin: 0 auto;
  }

  /* ── Card ── */
  #shopify-section-{{ section.id }} .bot-card {
    background: {{ section.settings.card_bg }};
    border-radius: var(--radius-md);
    padding: 1.4rem;
    border: 1px solid {{ section.settings.card_border }};
    transition: transform .4s cubic-bezier(.2,.8,.2,1), box-shadow .4s;
  }

  /* ── Swatch — image or fallback gradient ── */
  #shopify-section-{{ section.id }} .bot-card-swatch {
    height: auto;
    border-radius: var(--radius-sm);
    margin-bottom: 1.1rem;
    overflow: hidden;
    position: relative;
    background: {{ section.settings.swatch_fallback }};
    aspect-ratio:1/1;
    Width:100%;
    overflow:hidden;
  }
  #shopify-section-{{ section.id }} .bot-card-swatch img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    background-color:#fff;
    aspect-ratio:1/1;
    overflow:hidden;
  }

  /* ── Card text ── */
  #shopify-section-{{ section.id }} .bot-card h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.5rem;
    color: {{ section.settings.card_title_color }};
    margin-bottom: 0;
    line-height: 1.1;
  }
  #shopify-section-{{ section.id }} .bot-card p {
    font-size: .9rem;
    color: {{ section.settings.card_desc_color }};
    opacity: .78;
    margin: .4rem 0 .9rem;
    line-height: 1.5;
  }

  /* ── Tag pill ── */
  #shopify-section-{{ section.id }} .bot-card-tag {
    display: inline-block;
    font-size: .68rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: {{ section.settings.tag_color }};
    background: {{ section.settings.tag_bg }};
    padding: .34rem .7rem;
    border-radius: 100px;
  }

  /* ── Responsive ── */
  @media (max-width: 980px) {
    #shopify-section-{{ section.id }} .bot-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    #shopify-section-{{ section.id }} .bot-catalogue {
      padding: 2.6rem 1.2rem;
    }
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .bot-grid.slick-initialized {
      display: block;
      position: relative;
    }
    #shopify-section-{{ section.id }} .bot-grid.slick-initialized .slick-track {
      display: flex !important;
      align-items: stretch;
    }
    #shopify-section-{{ section.id }} .bot-grid.slick-initialized .slick-slide {
      height: auto;
      display: flex !important;
      flex-direction: column;
    }
    #shopify-section-{{ section.id }} .bot-grid.slick-initialized .bot-card {
      margin: 0 8px;
      height: 100%;
      box-sizing: border-box;
    }
    #shopify-section-{{ section.id }} .bot-grid.slick-initialized .slick-arrow {
      position: absolute;
      top: 42%;
      transform: translateY(-50%);
      z-index: 5;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: {{ section.settings.card_bg }};
      color: {{ section.settings.heading_color }};
      border: 1px solid {{ section.settings.card_border }};
      display: flex !important;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(42, 10, 32, 0.1);
      transition: all 0.3s ease;
      padding: 0;
    }
    #shopify-section-{{ section.id }} .bot-grid.slick-initialized .slick-arrow:hover {
      background: {{ section.settings.eyebrow_color }};
      color: #ffffff;
      border-color: {{ section.settings.eyebrow_color }};
    }
    #shopify-section-{{ section.id }} .bot-grid.slick-initialized .slick-arrow svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
      stroke: currentColor;
      display: block;
    }
    #shopify-section-{{ section.id }} .bot-grid.slick-initialized .slick-prev {
      left: 4px;
    }
    #shopify-section-{{ section.id }} .bot-grid.slick-initialized .slick-prev svg {
      transform: rotate(180deg);
    }
    #shopify-section-{{ section.id }} .bot-grid.slick-initialized .slick-next {
      right: 4px;
    }
  }
</style>

<section class="bot-catalogue" id="bot-catalogue-{{ section.id }}">

  <div class="section-header reveal-up">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="section-sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="bot-grid">
    {%- for block in section.blocks -%}
      <div class="bot-card reveal-up" {{ block.shopify_attributes }}>

        <div
          class="bot-card-swatch"
          {%- if block.settings.image == blank -%}
            style="background: {{ block.settings.fallback_bg }};"
          {%- endif -%}
        >
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.image.alt | default: block.settings.name | escape }}"
              width="600"
              height="300"
              loading="lazy"
            >
          {%- endif -%}
        </div>

        {%- if block.settings.name != blank -%}
          <h3>{{ block.settings.name }}</h3>
        {%- endif -%}
        {%- if block.settings.description != blank -%}
          <p>{{ block.settings.description }}</p>
        {%- endif -%}
        {%- if block.settings.tag != blank -%}
          <span class="bot-card-tag">{{ block.settings.tag }}</span>
        {%- endif -%}

      </div>
    {%- endfor -%}
  </div>

</section>

<script>
  (function() {
    function initBotCatalogueSlider() {
      var $ = window.jQuery;
      if (!$ || !$.fn || !$.fn.slick) {
        setTimeout(initBotCatalogueSlider, 100);
        return;
      }
      var $grid = $('#shopify-section-{{ section.id }} .bot-grid');
      if (!$grid.length) return;

      function checkAndInit() {
        if (window.innerWidth <= 767) {
          if (!$grid.hasClass('slick-initialized')) {
            var nextArrowIcon = (window.arrows && window.arrows.icon_next) ? window.arrows.icon_next : '<button type="button" class="slick-next" aria-label="Next"><svg viewBox="0 0 24 24"><path d="M7.293 4.707 14.586 12l-7.293 7.293 1.414 1.414L17.414 12 8.707 3.293 7.293 4.707z" fill="currentColor"></path></svg></button>';
            var prevArrowIcon = (window.arrows && window.arrows.icon_prev) ? window.arrows.icon_prev : '<button type="button" class="slick-prev" aria-label="Previous"><svg viewBox="0 0 24 24"><path d="M7.293 4.707 14.586 12l-7.293 7.293 1.414 1.414L17.414 12 8.707 3.293 7.293 4.707z" fill="currentColor"></path></svg></button>';

            $grid.slick({
              slidesToShow: 1,
              slidesToScroll: 1,
              autoplay: true,
              autoplaySpeed: 3000,
              dots: false,
              arrows: true,
              nextArrow: nextArrowIcon,
              prevArrow: prevArrowIcon,
              infinite: true,
              centerMode: false,
              adaptiveHeight: false,
              responsive: [
                {
                  breakpoint: 768,
                  settings: {
                    slidesToShow: 2,
                    slidesToScroll: 1,
                    autoplay: true,
                    autoplaySpeed: 3000,
                    dots: false,
                    arrows: true,
                    nextArrow: nextArrowIcon,
                    prevArrow: prevArrowIcon
                  }
                },
                {
                  breakpoint: 576,
                  settings: {
                    slidesToShow: 1,
                    slidesToScroll: 1,
                    autoplay: true,
                    autoplaySpeed: 3000,
                    dots: false,
                    arrows: true,
                    nextArrow: nextArrowIcon,
                    prevArrow: prevArrowIcon
                  }
                }
              ]
            });
          }
        } else {
          if ($grid.hasClass('slick-initialized')) {
            $grid.slick('unslick');
          }
        }
      }

      checkAndInit();
      $(window).off('resize.botCatalogue{{ section.id }} orientationchange.botCatalogue{{ section.id }}').on('resize.botCatalogue{{ section.id }} orientationchange.botCatalogue{{ section.id }}', checkAndInit);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBotCatalogueSlider);
    } else {
      initBotCatalogueSlider();
    }
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        initBotCatalogueSlider();
      }
    });
  })();
</script>

