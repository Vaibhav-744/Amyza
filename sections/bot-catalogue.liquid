{% comment %} bot-catalogue.liquid — Full botanical apothecary grid {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .bot-catalogue {
    padding: clamp(3rem, 7vw, 6rem) 6vw;
    background: {{ section.settings.section_bg }};
  }

  /* ── Section header ── */
  #shopify-section-{{ section.id }} .bot-catalogue .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(2rem, 4vw, 3.2rem);
  }
  #shopify-section-{{ section.id }} .bot-catalogue .eyebrow {
    color: {{ section.settings.eyebrow_color }};
  }
  #shopify-section-{{ section.id }} .bot-catalogue .section-header h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    color: {{ section.settings.heading_color }};
    margin: .6rem 0 .8rem;
    line-height: 1.1;
  }
  #shopify-section-{{ section.id }} .bot-catalogue .section-header h2 em {
    color: {{ section.settings.heading_italic_color }};
  }
  #shopify-section-{{ section.id }} .bot-catalogue .section-sub {
    color: {{ section.settings.sub_color }};
    font-size: 1rem;
    line-height: 1.6;
  }

  /* ── Grid ── */
  #shopify-section-{{ section.id }} .bot-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.4rem;
    max-width: 1300px;
    margin: 0 auto;
  }

  /* ── Card ── */
  #shopify-section-{{ section.id }} .bot-card {
    background: {{ section.settings.card_bg }};
    border-radius: var(--radius-md);
    padding: 1.4rem;
    border: 1px solid {{ section.settings.card_border }};
    transition: transform .4s cubic-bezier(.2,.8,.2,1), box-shadow .4s;
  }

  /* ── Swatch — image or fallback gradient ── */
  #shopify-section-{{ section.id }} .bot-card-swatch {
    height: auto;
    border-radius: var(--radius-sm);
    margin-bottom: 1.1rem;
    overflow: hidden;
    position: relative;
    background: {{ section.settings.swatch_fallback }};
    aspect-ratio:1/1;
    Width:100%;
    overflow:hidden;
  }
  #shopify-section-{{ section.id }} .bot-card-swatch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Card text ── */
  #shopify-section-{{ section.id }} .bot-card h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.5rem;
    color: {{ section.settings.card_title_color }};
    margin-bottom: 0;
    line-height: 1.1;
  }
  #shopify-section-{{ section.id }} .bot-card p {
    font-size: .9rem;
    color: {{ section.settings.card_desc_color }};
    opacity: .78;
    margin: .4rem 0 .9rem;
    line-height: 1.5;
  }

  /* ── Tag pill ── */
  #shopify-section-{{ section.id }} .bot-card-tag {
    display: inline-block;
    font-size: .68rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: {{ section.settings.tag_color }};
    background: {{ section.settings.tag_bg }};
    padding: .34rem .7rem;
    border-radius: 100px;
  }

  /* ── Responsive ── */
  @media (max-width: 980px) {
    #shopify-section-{{ section.id }} .bot-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    #shopify-section-{{ section.id }} .bot-catalogue {
      padding: 2.6rem 1.2rem;
    }
  }
  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .bot-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="bot-catalogue" id="bot-catalogue-{{ section.id }}">

  <div class="section-header reveal-up">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="section-sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="bot-grid">
    {%- for block in section.blocks -%}
      <div class="bot-card reveal-up" {{ block.shopify_attributes }}>

        <div
          class="bot-card-swatch"
          {%- if block.settings.image == blank -%}
            style="background: {{ block.settings.fallback_bg }};"
          {%- endif -%}
        >
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.image.alt | default: block.settings.name | escape }}"
              width="600"
              height="300"
              loading="lazy"
            >
          {%- endif -%}
        </div>

        {%- if block.settings.name != blank -%}
          <h3>{{ block.settings.name }}</h3>
        {%- endif -%}
        {%- if block.settings.description != blank -%}
          <p>{{ block.settings.description }}</p>
        {%- endif -%}
        {%- if block.settings.tag != blank -%}
          <span class="bot-card-tag">{{ block.settings.tag }}</span>
        {%- endif -%}

      </div>
    {%- endfor -%}
  </div>

</section>

