{% comment %} about-stats.liquid — Stats strip {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .about-stats {
    background: {{ section.settings.section_bg }};
    padding: clamp(3.5rem, 7vw, 6rem) 6vw;
  }
  #shopify-section-{{ section.id }} .about-stats-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, 1fr);
    gap: 2rem;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .stat-item strong {
    display: block;
    font-family: var(--serif);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    color: {{ section.settings.stat_num_color }};
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .stat-item span {
    display: block;
    margin-top: .6rem;
    font-size: .82rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: {{ section.settings.stat_label_color }};
  }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .about-stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 2rem;
    }
    #shopify-section-{{ section.id }} .about-stats {
      padding: 3rem 1.2rem;
    }
  }
  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .about-stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<section class="about-stats" id="about-stats-{{ section.id }}">
  <div class="about-stats-grid">
    {%- for block in section.blocks -%}
      <div class="stat-item reveal-up" {{ block.shopify_attributes }}>
        {%- if block.settings.number != blank -%}
          <strong>{{ block.settings.number }}</strong>
        {%- endif -%}
        {%- if block.settings.label != blank -%}
          <span>{{ block.settings.label }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const section = document.querySelector(".about-stats");

  if (!section) return;

  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;

      const counters = entry.target.querySelectorAll(".stat-item strong");

      counters.forEach(counter => {
        const finalText = counter.textContent.trim();

        // Extract numeric value
        const target = parseInt(finalText.replace(/\D/g, ""), 10);

        if (isNaN(target)) return;

        // Preserve prefixes/suffixes
        const prefix = finalText.match(/^[^\d]+/)?.[0] || "";
        const suffix = finalText.match(/[^\d]+$/)?.[0] || "";

        const duration = 2000;
        const startTime = performance.now();

        function update(currentTime) {
          const progress = Math.min((currentTime - startTime) / duration, 1);
          const value = Math.floor(progress * target);

          counter.textContent = `${prefix}${value}${suffix}`;

          if (progress < 1) {
            requestAnimationFrame(update);
          } else {
            counter.textContent = finalText;
          }
        }

        requestAnimationFrame(update);
      });

      observer.unobserve(entry.target);
    });
  }, {
    threshold: 0.4
  });

  observer.observe(section);
});
</script>

{% schema %}
{
  "name": "About — Stats",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "default": "#EDE8E6",
      "info": "Default: --porcelain-soft"
    },
    {
      "type": "color",
      "id": "stat_num_color",
      "label": "Number Color",
      "default": "#731157"
    },
    {
      "type": "color",
      "id": "stat_label_color",
      "label": "Label Color",
      "default": "#7a6270"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number / Value",
          "default": "500+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "5-star reviews"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Stats",
      "blocks": [
        {
          "type": "stat",
          "settings": { "number": "500+", "label": "5-star reviews" }
        },
        {
          "type": "stat",
          "settings": { "number": "100%", "label": "Cruelty-free" }
        },
        {
          "type": "stat",
          "settings": { "number": "2", "label": "Cultures, one ritual" }
        },
        {
          "type": "stat",
          "settings": { "number": "0", "label": "Parabens & alcohol" }
        }
      ]
    }
  ]
}
{% endschema %}
